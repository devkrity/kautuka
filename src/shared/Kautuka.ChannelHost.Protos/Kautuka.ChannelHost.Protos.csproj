<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>true</IsPackable>
    <PackageId>Kautuka.ChannelGateway.Grpc</PackageId>
    <Description>Versioned gRPC transport and authorization-envelope contract for Kautuka Channel Gateway.</Description>
    <PackageTags>grpc;channels;workload-identity</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Core.Api" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\channelhost.proto" GrpcServices="Both" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
