# Exclude non-source artefacts from the Podman build context (src/).
# Keeps the context small for multi-stage .NET service builds.
**/bin/
**/obj/
**/TestResults/
**/artifacts/
**/appsettings.Development.json
**/appsettings.*.local.json
**/Properties/launchSettings.json
**/secrets.json
**/.env
**/.env.*
**/*.pfx
**/*.p12
**/*.key
**/*.db
**/*.db-shm
**/*.db-wal
**/*.sqlite
**/*.sqlite3
logs/
frontend/
tests/
