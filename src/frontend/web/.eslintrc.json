{
  "env": {
    "browser": true,
    "es2020": true,
    "node": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended-type-checked",
    "plugin:@typescript-eslint/stylistic-type-checked",
    "plugin:react/recommended",
    "plugin:react/jsx-runtime",
    "plugin:browser-security/recommended",
    "plugin:secure-coding/recommended"
  ],
  "ignorePatterns": ["dist", ".eslintrc.json", "vitest.config.ts", "vite.config.ts", "src/lib/api/generated"],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    },
    "projectService": true
  },
  "plugins": ["@typescript-eslint", "react", "browser-security", "secure-coding"],
  "rules": {
    "@typescript-eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_"
      }
    ],
    "@typescript-eslint/explicit-function-return-types": "warn",
    "@typescript-eslint/explicit-module-boundary-types": "warn",
    "@typescript-eslint/no-explicit-any": "error",
    "@typescript-eslint/no-non-null-assertion": "error",
    "@typescript-eslint/prefer-nullish-coalescing": "warn",
    "@typescript-eslint/prefer-optional-chain": "warn",
    "@typescript-eslint/strict-boolean-expressions": "warn",
    "@typescript-eslint/no-unsafe-member-access": "off",
    "no-console": [
      "warn",
      {
        "allow": ["warn", "error"]
      }
    ],
    "react/prop-types": "off",
    "react/react-in-jsx-scope": "off",
    "no-implicit-coercion": "error",
    "eqeqeq": ["error", "always"],
    "secure-coding/detect-object-injection": "warn",
    "secure-coding/no-hardcoded-credentials": "warn",
    "browser-security/no-hardcoded-secrets": "warn"
  },
  "settings": {
    "react": {
      "version": "detect"
    }
  }
}
