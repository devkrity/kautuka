admin:
  address:
    pipe:
      path: {{ADMIN_SOCKET_PATH}}
      mode: 384
layered_runtime:
  layers:
    - name: static_layer
      static_layer:
        envoy.reloadable_features.tcp_proxy_delay_route_selection: true
static_resources:
  listeners:
    - name: workload_tcp
      address:
        socket_address:
          address: 0.0.0.0
          port_value: 15001
      listener_filters:
        - name: envoy.filters.listener.original_dst
          typed_config:
            "@type": type.googleapis.com/envoy.extensions.filters.listener.original_dst.v3.OriginalDst
        - name: envoy.filters.listener.tls_inspector
          typed_config:
            "@type": type.googleapis.com/envoy.extensions.filters.listener.tls_inspector.v3.TlsInspector
      access_log:
        - name: envoy.access_loggers.stderr
          typed_config:
            "@type": type.googleapis.com/envoy.extensions.access_loggers.stream.v3.StderrAccessLog
            log_format:
              text_format_source:
                inline_string: "[nac] sni=%REQUESTED_SERVER_NAME% src=%DOWNSTREAM_REMOTE_ADDRESS% dst=%DOWNSTREAM_LOCAL_ADDRESS% flags=%RESPONSE_FLAGS% dur=%DURATION%\n"
      filter_chains:
        - filter_chain_match:
            transport_protocol: tls
          filters:
            - name: envoy.filters.network.ext_authz
              typed_config:
                "@type": type.googleapis.com/envoy.extensions.filters.network.ext_authz.v3.ExtAuthz
                stat_prefix: nac_tls
                transport_api_version: V3
                failure_mode_allow: false
                include_tls_session: true
                grpc_service:
                  envoy_grpc:
                    cluster_name: manager-authorization
                    authority: kautuka-decision.internal
                  timeout: 2s
            - name: envoy.filters.network.set_filter_state
              typed_config:
                "@type": type.googleapis.com/envoy.extensions.filters.network.set_filter_state.v3.Config
                on_downstream_data:
                  - object_key: envoy.tcp_proxy.cluster
                    format_string:
                      text_format_source:
                        inline_string: "%DYNAMIC_METADATA(envoy.filters.network.ext_authz:cluster)%"
            - name: envoy.filters.network.tcp_proxy
              typed_config:
                "@type": type.googleapis.com/envoy.extensions.filters.network.tcp_proxy.v3.TcpProxy
                stat_prefix: tcp_tls
                cluster: dfp_public
                upstream_connect_mode: ON_DOWNSTREAM_DATA
                max_early_data_bytes: 8192
        - filter_chain_match: {}
          filters:
            - name: envoy.filters.network.ext_authz
              typed_config:
                "@type": type.googleapis.com/envoy.extensions.filters.network.ext_authz.v3.ExtAuthz
                stat_prefix: nac_plain
                transport_api_version: V3
                failure_mode_allow: false
                grpc_service:
                  envoy_grpc:
                    cluster_name: manager-authorization
                    authority: kautuka-decision.internal
                  timeout: 2s
            - name: envoy.filters.network.set_filter_state
              typed_config:
                "@type": type.googleapis.com/envoy.extensions.filters.network.set_filter_state.v3.Config
                on_downstream_data:
                  - object_key: envoy.tcp_proxy.cluster
                    format_string:
                      text_format_source:
                        inline_string: "%DYNAMIC_METADATA(envoy.filters.network.ext_authz:cluster)%"
            - name: envoy.filters.network.tcp_proxy
              typed_config:
                "@type": type.googleapis.com/envoy.extensions.filters.network.tcp_proxy.v3.TcpProxy
                stat_prefix: tcp_plain
                cluster: orig_dst_public
                upstream_connect_mode: ON_DOWNSTREAM_DATA
                max_early_data_bytes: 8192
    - name: dfp_public_in
      address:
        socket_address:
          address: 127.0.0.1
          port_value: 15002
      listener_filters:
        - name: envoy.filters.listener.proxy_protocol
          typed_config:
            "@type": type.googleapis.com/envoy.extensions.filters.listener.proxy_protocol.v3.ProxyProtocol
        - name: envoy.filters.listener.tls_inspector
          typed_config:
            "@type": type.googleapis.com/envoy.extensions.filters.listener.tls_inspector.v3.TlsInspector
      filter_chains:
        - filters:
            - name: envoy.filters.network.set_filter_state
              typed_config:
                "@type": type.googleapis.com/envoy.extensions.filters.network.set_filter_state.v3.Config
                on_new_connection:
                  - object_key: envoy.upstream.dynamic_port
                    format_string:
                      text_format_source:
                        inline_string: "%DOWNSTREAM_LOCAL_PORT%"
            - name: envoy.filters.network.sni_dynamic_forward_proxy
              typed_config:
                "@type": type.googleapis.com/envoy.extensions.filters.network.sni_dynamic_forward_proxy.v3.FilterConfig
                dns_cache_config:
                  name: dfp_cache
                  dns_lookup_family: V4_ONLY
                  resolved_address_filter:
                    ranges:
                      {{RESOLVED_FILTER_PUBLIC}}
                  typed_dns_resolver_config:
                    name: envoy.network.dns_resolver.cares
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.network.dns_resolver.cares.v3.CaresDnsResolverConfig
                      resolvers:
                        - socket_address:
                            address: 127.0.0.1
                            port_value: 10053
            - name: envoy.filters.network.tcp_proxy
              typed_config:
                "@type": type.googleapis.com/envoy.extensions.filters.network.tcp_proxy.v3.TcpProxy
                stat_prefix: tcp_tls_public
                cluster: dfp_public_egress
    - name: dfp_lan_in
      address:
        socket_address:
          address: 127.0.0.1
          port_value: 15003
      listener_filters:
        - name: envoy.filters.listener.proxy_protocol
          typed_config:
            "@type": type.googleapis.com/envoy.extensions.filters.listener.proxy_protocol.v3.ProxyProtocol
        - name: envoy.filters.listener.tls_inspector
          typed_config:
            "@type": type.googleapis.com/envoy.extensions.filters.listener.tls_inspector.v3.TlsInspector
      filter_chains:
        - filters:
            - name: envoy.filters.network.set_filter_state
              typed_config:
                "@type": type.googleapis.com/envoy.extensions.filters.network.set_filter_state.v3.Config
                on_new_connection:
                  - object_key: envoy.upstream.dynamic_port
                    format_string:
                      text_format_source:
                        inline_string: "%DOWNSTREAM_LOCAL_PORT%"
            - name: envoy.filters.network.sni_dynamic_forward_proxy
              typed_config:
                "@type": type.googleapis.com/envoy.extensions.filters.network.sni_dynamic_forward_proxy.v3.FilterConfig
                dns_cache_config:
                  name: dfp_cache_lan
                  dns_lookup_family: V4_ONLY
                  resolved_address_filter:
                    ranges:
                      {{RESOLVED_FILTER_LAN}}
                  typed_dns_resolver_config:
                    name: envoy.network.dns_resolver.cares
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.network.dns_resolver.cares.v3.CaresDnsResolverConfig
                      resolvers:
                        - socket_address:
                            address: 127.0.0.1
                            port_value: 10053
            - name: envoy.filters.network.tcp_proxy
              typed_config:
                "@type": type.googleapis.com/envoy.extensions.filters.network.tcp_proxy.v3.TcpProxy
                stat_prefix: tcp_tls_lan
                cluster: dfp_lan_egress
  clusters:
    - name: manager-authorization
      connect_timeout: 0.5s
      typed_extension_protocol_options:
        envoy.extensions.upstreams.http.v3.HttpProtocolOptions:
          "@type": type.googleapis.com/envoy.extensions.upstreams.http.v3.HttpProtocolOptions
          explicit_http_config:
            http2_protocol_options: {}
{{MANAGER_AUTHORIZATION_CLUSTER}}
    - name: dfp_public
      type: STATIC
      connect_timeout: 1s
      lb_policy: ROUND_ROBIN
      transport_socket:
        name: envoy.transport_sockets.upstream_proxy_protocol
        typed_config:
          "@type": type.googleapis.com/envoy.extensions.transport_sockets.proxy_protocol.v3.ProxyProtocolUpstreamTransport
          config:
            version: V2
          transport_socket:
            name: envoy.transport_sockets.raw_buffer
            typed_config:
              "@type": type.googleapis.com/envoy.extensions.transport_sockets.raw_buffer.v3.RawBuffer
      load_assignment:
        cluster_name: dfp_public
        endpoints:
          - lb_endpoints:
              - endpoint:
                  address:
                    socket_address:
                      address: 127.0.0.1
                      port_value: 15002
    - name: dfp_public_egress
      lb_policy: CLUSTER_PROVIDED
      cluster_type:
        name: envoy.clusters.dynamic_forward_proxy
        typed_config:
          "@type": type.googleapis.com/envoy.extensions.clusters.dynamic_forward_proxy.v3.ClusterConfig
          dns_cache_config:
            name: dfp_cache
            dns_lookup_family: V4_ONLY
            resolved_address_filter:
              ranges:
                {{RESOLVED_FILTER_PUBLIC}}
            typed_dns_resolver_config:
              name: envoy.network.dns_resolver.cares
              typed_config:
                "@type": type.googleapis.com/envoy.extensions.network.dns_resolver.cares.v3.CaresDnsResolverConfig
                resolvers:
                  - socket_address:
                      address: 127.0.0.1
                      port_value: 10053
    - name: orig_dst_public
      type: ORIGINAL_DST
      lb_policy: CLUSTER_PROVIDED
      connect_timeout: 2s
    - name: dfp_lan
      type: STATIC
      connect_timeout: 1s
      lb_policy: ROUND_ROBIN
      transport_socket:
        name: envoy.transport_sockets.upstream_proxy_protocol
        typed_config:
          "@type": type.googleapis.com/envoy.extensions.transport_sockets.proxy_protocol.v3.ProxyProtocolUpstreamTransport
          config:
            version: V2
          transport_socket:
            name: envoy.transport_sockets.raw_buffer
            typed_config:
              "@type": type.googleapis.com/envoy.extensions.transport_sockets.raw_buffer.v3.RawBuffer
      load_assignment:
        cluster_name: dfp_lan
        endpoints:
          - lb_endpoints:
              - endpoint:
                  address:
                    socket_address:
                      address: 127.0.0.1
                      port_value: 15003
    - name: dfp_lan_egress
      lb_policy: CLUSTER_PROVIDED
      upstream_bind_config:
        source_address:
          address: {{LAN_SOURCE_IP}}
          port_value: 0
      cluster_type:
        name: envoy.clusters.dynamic_forward_proxy
        typed_config:
          "@type": type.googleapis.com/envoy.extensions.clusters.dynamic_forward_proxy.v3.ClusterConfig
          dns_cache_config:
            name: dfp_cache_lan
            dns_lookup_family: V4_ONLY
            resolved_address_filter:
              ranges:
                {{RESOLVED_FILTER_LAN}}
            typed_dns_resolver_config:
              name: envoy.network.dns_resolver.cares
              typed_config:
                "@type": type.googleapis.com/envoy.extensions.network.dns_resolver.cares.v3.CaresDnsResolverConfig
                resolvers:
                  - socket_address:
                      address: 127.0.0.1
                      port_value: 10053
    - name: orig_dst_lan
      type: ORIGINAL_DST
      lb_policy: CLUSTER_PROVIDED
      connect_timeout: 2s
      upstream_bind_config:
        source_address:
          address: {{LAN_SOURCE_IP}}
          port_value: 0
