<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <NoWarn>$(NoWarn);CA1515;CA1848;CA1873;CA1031;CA1822;CA1054;CA1056;CA1308</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\shared\Kautuka.Hosting\Kautuka.Hosting.csproj" />
    <ProjectReference Include="..\..\shared\Kautuka.Manager.Protos\Kautuka.Manager.Protos.csproj" />
    <ProjectReference Include="..\Kautuka.NetworkAccessController\Kautuka.NetworkAccessController.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.Core" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Hosting\NetworkAccess\*.tmpl" Exclude="Hosting\NetworkAccess\kautuka_workload.nft.json.tmpl" />
    <EmbeddedResource Include="..\..\..\scripts\nac\kautuka_workload.nft.json.tmpl">
      <LogicalName>Kautuka.Manager.RuntimeContainer.Hosting.NetworkAccess.kautuka_workload.nft.json.tmpl</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Kautuka.IntegrationTests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Kautuka.NetworkAccess.Acceptance</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
