<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CA1303;CA1812;CA1515;IDE0130</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../backend/Kautuka.Manager.RuntimeContainer/Hosting/NetworkAccess/WorkloadRulesetRenderer.cs" Link="WorkloadRulesetRenderer.cs" />
    <Compile Include="../../backend/Kautuka.Manager.RuntimeContainer/Hosting/NetworkAccess/NftRulesetCanonicalizer.cs" Link="NftRulesetCanonicalizer.cs" />
    <EmbeddedResource Include="../../../scripts/nac/kautuka_workload.nft.json.tmpl" LogicalName="Kautuka.OciHook.kautuka_workload.nft.json.tmpl" />
    <EmbeddedResource Include="../../../scripts/nac/kautuka_package_proxy.nft.json.tmpl" LogicalName="Kautuka.OciHook.kautuka_package_proxy.nft.json.tmpl" />
    <EmbeddedResource Include="kautuka_appliance_gateway.nft.json.tmpl" LogicalName="Kautuka.OciHook.kautuka_appliance_gateway.nft.json.tmpl" />
    <EmbeddedResource Include="kautuka_appliance_webhost.nft.json.tmpl" LogicalName="Kautuka.OciHook.kautuka_appliance_webhost.nft.json.tmpl" />
    <EmbeddedResource Include="kautuka_appliance_observability.nft.json.tmpl" LogicalName="Kautuka.OciHook.kautuka_appliance_observability.nft.json.tmpl" />
    <EmbeddedResource Include="kautuka_appliance_telemetry_only.nft.json.tmpl" LogicalName="Kautuka.OciHook.kautuka_appliance_telemetry_only.nft.json.tmpl" />
  </ItemGroup>
</Project>
