<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <PublishAot>false</PublishAot>
    <NoWarn>$(NoWarn);CA2007;CA1861</NoWarn>
    <!--
      Pre-commit excludes this suite with a FullyQualifiedName negation filter.
      Under Microsoft Testing Platform, a filter that matches zero tests fails with exit code 8;
      the husky/CI commands pass ignore-exit-code 8 for those filtered solution runs.
      Direct dotnet test on this csproj (no filter) still runs the suite.
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\backend\Kautuka.Gateway\Kautuka.Gateway.csproj" />
  </ItemGroup>

</Project>
