* text=auto

# Enforce LF for source code
*.cs text eol=lf
*.csx text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.sh.in text eol=lf
*.in text eol=lf
*.ps1 text eol=lf
compliance/licenses/*.txt text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf

# Mark binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary
*.tar binary
*.db binary
*.db-wal binary
*.db-shm binary
