#!/usr/bin/env bash
if [ -z "${BASH_VERSION:-}" ]; then
    printf '%s\n' 'error: this installer requires Bash; run it with `sudo bash ./kautuka-install-linux.sh`.' >&2
    exit 2
fi
if shopt -oq posix; then
    printf '%s\n' 'error: this installer requires Bash mode; run it with `sudo bash ./kautuka-install-linux.sh`, not `sh`.' >&2
    exit 2
fi
set -euo pipefail

: "${KAUTUKA_DEFAULT_ARTIFACT_URL:=}"
: "${KAUTUKA_DEFAULT_FEED_BASE_URL:=}"
: "${KAUTUKA_DEFAULT_MANIFEST_URL:=}"
: "${KAUTUKA_DEFAULT_MANIFEST_PUBLIC_KEY_PEM:=}"
: "${KAUTUKA_DEFAULT_VERSION:=}"
: "${KAUTUKA_DEFAULT_RELEASE_CHANNEL:=}"
: "${KAUTUKA_DEFAULT_REPOSITORY_OWNER:=devkrity}"
: "${KAUTUKA_DEFAULT_REPOSITORY_NAME:=kautuka}"

usage() {
    cat <<'EOF'
Usage: sudo ./kautuka-install-linux.sh --artifact <path> --version <version> [options]

    or: sudo ./kautuka-install-linux.sh --uninstall [options]

Options:
    --artifact <path>         Path to kautuka-linux-amd64.tar.gz
    --artifact-url <url>     Download the platform artifact from this URL with visible progress
    --feed-base-url <url>    Release feed base URL. Derives artifact download and manifest URLs.
    --version <version>       Installed version used under versions/<version>
  --install-root <path>     Install root for Manager versions (default: /opt/kautuka/manager)
    --internal-state-root <path>
                                                        Internal runtime state root (default: /var/lib/kautuka)
    --visible-root <path>     Visible logs/workspaces root (default: /var/lib/kautuka)
    --unit-name <name>        Manager user unit filename (default: kautuka-manager.service)
  --service-user <name>     Service account user (default: kautuka)
  --service-group <name>    Service account group (default: same as user)
    --uninstall               Remove installed Kautuka Linux services and binaries
        --delete-data             Also delete preserved Kautuka databases and agent workspace files during uninstall
        --yes                     Skip prompts and confirm deletion, including databases and workspace files
    --skip-enable             Install files but do not enable/start the user systemd target
  --help                    Show this help

When this script is published as a release asset, it may embed defaults for
--artifact-url and --version so it can be run directly without extra flags.

If the release artifact also contains sibling native services under services/,
this installer provisions ordinary appliance services as user units. Production
Gateway and ChannelHost are always separate system units with isolated service
principals and private-key inventories.
EOF
}

# Called under the shared update lock. The helper can release that lock while
# its durable transaction is still awaiting commit or recovery.
assert_no_unresolved_update() {
    local recovery_root="${1:-/var/lib/kautuka-recovery}"
    local marker="$recovery_root/maintenance.json" journal="$recovery_root/operation.json"
    [[ ! -e "$marker" && ! -L "$marker" ]] || fail 'an update requires completion or recovery before installation can proceed'
    [[ ! -L "$journal" ]] || fail 'update journal is not a regular file; installation cannot proceed'
    if [[ -e "$journal" ]]; then
        [[ -f "$journal" ]] || fail 'update journal is not a regular file; installation cannot proceed'
        python3 - "$journal" <<'PY' || fail 'an update requires completion or recovery before installation can proceed'
import json, sys
try:
    with open(sys.argv[1], encoding='utf-8') as stream:
        journal = json.load(stream)
    if not isinstance(journal, dict) or journal.get('phase') not in ('committed', 'completed', 'aborted'):
        raise ValueError('unresolved update')
except (OSError, ValueError, TypeError):
    sys.exit(1)
PY
    fi
}

normalize_feed_base_url() {
    local raw_url="$1"
    local normalized="${raw_url%/}"

    case "$normalized" in
        */manifest)
            printf '%s\n' "${normalized%/manifest}"
            ;;
        */kautuka-platform-release.json)
            printf '%s\n' "${normalized%/kautuka-platform-release.json}"
            ;;
        *)
            printf '%s\n' "$normalized"
            ;;
    esac
}

manifest_url_from_feed_base_url() {
    local normalized_base
    normalized_base="$(normalize_feed_base_url "$1")"
    printf '%s/manifest\n' "$normalized_base"
}

artifact_url_from_feed_base_url() {
    local normalized_base
    normalized_base="$(normalize_feed_base_url "$1")"
    printf '%s/kautuka-linux-amd64.tar.gz\n' "$normalized_base"
}

resolve_github_release_candidate() {
    local channel="$1"
    local owner="$2"
    local repository="$3"
    if [[ ! "$owner" =~ ^[A-Za-z0-9_-]+$ || ! "$repository" =~ ^[A-Za-z0-9_-]+$ ]]; then
        fail 'canonical repository owner and name contain invalid characters'
    fi
    case "$channel" in
        stable|preview) ;;
        *) fail "unsupported release channel: $channel" ;;
    esac
    python3 - "$owner" "$repository" "$channel" <<'PY'
import json
import re
import sys
import urllib.request

owner, repository, channel = sys.argv[1:]
pattern = (r"v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)-preview\.(0|[1-9][0-9]*)"
           if channel == "preview" else r"v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)")
candidates = {}
try:
    for page in range(1, 12):
        url = f"https://api.github.com/repos/{owner}/{repository}/releases?per_page=100&page={page}"
        request = urllib.request.Request(url, headers={"Accept": "application/vnd.github+json", "User-Agent": "Kautuka-Linux-Installer/1.0"})
        with urllib.request.urlopen(request, timeout=20) as response:
            rows = json.load(response)
        if not isinstance(rows, list):
            raise RuntimeError("API response is not an array")
        if page == 11:
            if rows:
                raise RuntimeError("release history exceeds the safe 1,000-release discovery limit")
            break
        for release in rows:
            if not isinstance(release, dict) or not isinstance(release.get("tag_name"), str) or type(release.get("draft")) is not bool or type(release.get("prerelease")) is not bool or release.get("published_at") is not None and not isinstance(release.get("published_at"), str):
                raise RuntimeError("release metadata is malformed")
            tag = release.get("tag_name", "")
            match = re.fullmatch(pattern, tag)
            if release.get("draft") or not release.get("published_at") or release.get("prerelease") is not (channel == "preview") or match is None:
                print(f"Skipping non-eligible GitHub release {tag!r}", file=sys.stderr)
                continue
            version = tuple(int(part) for part in match.groups())
            if version in candidates:
                raise RuntimeError(f"multiple published {channel} releases claim the same version: {tag}")
            candidates[version] = tag
        if len(rows) < 100:
            break
except Exception as error:
    print(f"GitHub release discovery failed closed: {error}", file=sys.stderr)
    sys.exit(1)
if not candidates:
    print(f"no published strict {channel} release found", file=sys.stderr)
    sys.exit(1)
tag = candidates[max(candidates)]
print(tag + "\t" + f"https://github.com/{owner}/{repository}/releases/download/{tag}/kautuka-platform-release.json")
PY
}

write_update_source_document() {
    local manifest_url="$1"
    local service_user="$2"
    local service_group="$3"
    local destination='/etc/kautuka/update-source.json'

    mkdir -p "$(dirname "$destination")"

    if [[ -z "$manifest_url" ]]; then
        echo "info: no pinned update source written; UpdateService discovers signed GitHub releases by channel" >&2
        return 0
    fi

    cat > "$destination" <<EOF
{
    "schemaVersion": 1,
    "manifestUrl": "${manifest_url}"
}
EOF

    chmod 644 "$destination"
    chown_if_service_account "$service_user" "$service_group" "$destination"
}

write_trusted_manifest_public_key() {
    local public_key_pem="${1:-}"
    local destination="${2:-/etc/kautuka/manifest-public-key.pem}"

    if [[ -z "$public_key_pem" ]]; then
        return
    fi

    local destination_dir
    destination_dir="$(dirname "$destination")"
    mkdir -p "$destination_dir"
    chown root:root "$destination_dir"
    chmod go-w "$destination_dir"
    local temporary_key
    temporary_key="$(mktemp "$destination_dir/.manifest-public-key.XXXXXX")"
    cat > "$temporary_key" <<EOF
${public_key_pem}
EOF
    chmod 644 "$temporary_key"
    chown root:root "$temporary_key"
    mv -Tf "$temporary_key" "$destination"
}

require_trusted_manifest_public_key_for_network_install() {
    local manifest_url="$1"
    local public_key_pem="${2:-}"

    if [[ -z "$manifest_url" ]]; then
        return 0
    fi

    if [[ -z "$public_key_pem" ]]; then
        fail "network install requires an embedded manifest public key; rebuild the installer with --manifest-public-key"
    fi
}

chown_if_service_account() {
    local service_user="$1"
    local service_group="$2"
    shift 2
    if id "$service_user" >/dev/null 2>&1 && getent group "$service_group" >/dev/null 2>&1; then
        chown "$service_user:$service_group" "$@"
    fi
}

write_initial_update_runtime_policy() {
    local state_root="$1"
    local release_channel="$2"
    local service_user="$3"
    local service_group="$4"
    local policy_path="$state_root/updateService/update-runtime-policy.json"

    [[ "$release_channel" == 'stable' || "$release_channel" == 'preview' ]] || fail "unsupported release channel for initial update policy: $release_channel"
    [[ -e "$policy_path" ]] && return 0

    mkdir -p "$(dirname "$policy_path")"
    printf '{\n  "schemaVersion": 1,\n  "releaseChannel": "%s"\n}\n' "$release_channel" > "$policy_path"
    chmod 640 "$policy_path"
    chown_if_service_account "$service_user" "$service_group" "$policy_path"
}

copy_runtime_payload() {
    local source_root="$1"
    local destination_root="$2"

    # Payload files are extracted below a temporary directory. Do not copy that
    # directory's SELinux label into /opt: systemd may then refuse to exec the
    # service with status 203/EXEC. Let the destination inherit its policy label,
    # then apply the host's configured file contexts when restorecon is available.
    cp -a --no-preserve=context "$source_root/." "$destination_root/"
    local selinux_state=''
    if command -v getenforce >/dev/null 2>&1; then
        selinux_state="$(getenforce 2>/dev/null || true)"
    fi
    if command -v restorecon >/dev/null 2>&1 && [[ "$selinux_state" != 'Disabled' ]]; then
        restorecon -RF "$destination_root"
    fi
}

ensure_selinux_runtime_exec_policy() {
    local selinux_state=''
    if ! command -v getenforce >/dev/null 2>&1; then
        return 0
    fi
    selinux_state="$(getenforce 2>/dev/null || true)"
    if [[ "$selinux_state" == 'Disabled' || -z "$selinux_state" ]]; then
        return 0
    fi

    if ! command -v semanage >/dev/null 2>&1 || ! command -v restorecon >/dev/null 2>&1; then
        fail "SELinux is enabled; install policycoreutils-python-utils and policycoreutils to label Kautuka service executables"
    fi

    # Fedora's default /opt label is usr_t, which systemd cannot execute as a
    # service under enforcing SELinux. Give only versioned Kautuka executables
    # the standard executable type and persist the mapping for later updates.
    local rule='/opt/kautuka/[^/]+/versions/[^/]+/kautuka-[^/]+'
    if ! semanage fcontext -a -t bin_t "$rule" >/dev/null 2>&1; then
        semanage fcontext -m -t bin_t "$rule" >/dev/null 2>&1 || fail "could not register SELinux executable labeling rule for Kautuka; install policycoreutils-python-utils and check SELinux policy permissions"
    fi
}

write_service_scope_document() {
    local username="$1"
    local target="$2"

    mkdir -p /etc/kautuka
    cat > /etc/kautuka/service-scope.json <<EOF
{
  "schemaVersion": 2,
  "username": "${username}",
  "target": "${target}",
  "userUnits": ["kautuka-manager.service", "kautuka-updateservice.service", "kautuka-webhost.service"],
  "systemUnits": ["kautuka-gateway.service", "kautuka-channelhost.service", "kautuka-credentialshost.service"]
}
EOF
    chmod 644 /etc/kautuka/service-scope.json
}

fail() {
    echo "error: $*" >&2
    exit 1
}

require_root() {
    if [[ ${EUID} -ne 0 ]]; then
        fail "this installer must run as root"
    fi
}

require_command() {
    local cmd="$1"
    command -v "$cmd" >/dev/null 2>&1 || fail "required command not found: $cmd"
}

ensure_subid_entry() {
    local file_path="$1"
    local user="$2"

    if [[ ! -f "$file_path" ]]; then
        : > "$file_path"
    fi

    if grep -q "^${user}:" "$file_path" 2>/dev/null; then
        return 0
    fi

    local next_start=100000
    local computed_start=100000
    local line=''
    local start=''
    local count=''
    local numeric_start=0
    local numeric_count=0
    local end=0
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ -z "$line" || "$line" == \#* ]] && continue
        IFS=: read -r _ start count _ <<<"$line"
        [[ "$start" =~ ^[0-9]+$ && "$count" =~ ^[0-9]+$ ]] \
            || fail "invalid subordinate-ID range in $file_path"
        while [[ ${#start} -gt 1 && "${start:0:1}" == '0' ]]; do start="${start:1}"; done
        while [[ ${#count} -gt 1 && "${count:0:1}" == '0' ]]; do count="${count:1}"; done
        [[ ${#start} -le 10 && ${#count} -le 10 ]] \
            || fail "subordinate-ID range exceeds the Linux ID limit in $file_path"
        numeric_start=$((10#$start))
        numeric_count=$((10#$count))
        end=$((numeric_start + numeric_count))
        (( numeric_start <= 4294967294 && numeric_count > 0 && numeric_count <= 4294967295 && end <= 4294967295 )) \
            || fail "subordinate-ID range exceeds the Linux ID limit in $file_path"
        if (( end > computed_start )); then
            computed_start="$end"
        fi
    done < "$file_path"
    (( computed_start <= 4294967295 - 65536 )) \
        || fail "no free 65536-ID subordinate range remains in $file_path"
    next_start="$computed_start"

    # A final record without a newline is valid input; separate the new entry so it
    # does not concatenate with that record and become an invalid sub-ID line.
    if [[ -s "$file_path" ]]; then
        local last_character=''
        IFS= read -r -n 1 last_character < <(tail -c 1 "$file_path") || true
        if [[ -n "$last_character" ]]; then
            printf '\n' >> "$file_path"
        fi
    fi
    printf '%s:%s:65536\n' "$user" "$next_start" >> "$file_path"
}

get_service_user_home() {
    local service_user="$1"
    local service_home=''
    IFS=: read -r _ _ _ _ _ service_home _ < <(getent passwd "$service_user")
    [[ -n "$service_home" ]] || fail "could not resolve home directory for service user: $service_user"
    printf '%s\n' "$service_home"
}

validate_linger_enabled() {
    local service_user="$1"
    [[ -f "/var/lib/systemd/linger/${service_user}" ]] || fail "systemd linger was not enabled for service user: $service_user"
}

install_user_manager_restart_dropin() {
    local service_user="$1"
    local service_uid=''
    service_uid="$(id -u "$service_user")"
    local dropin_dir="/etc/systemd/system/user@${service_uid}.service.d"

    # TimeoutStopSec bounds only the teardown of the user manager itself, so the
    # manager unit keeps its own 70s for targeted stops and apply-release. Without
    # it, podman retries transient scopes that systemd refuses once exit.target is
    # queued, and a host shutdown that outruns that leaves the cgroup behind, so
    # the next start fails with EBUSY on cgroup reuse (systemd/systemd#41278).
    # Restart= is the safety net for any teardown that still fails to complete:
    # user@.service is static with no Restart=, so one leak would otherwise strand
    # the user-scope services for a whole boot while the system units still report
    # healthy. The leaked cgroup is empty, so a single retry claims it.
    mkdir -p "$dropin_dir"
    cat > "$dropin_dir/20-kautuka-restart.conf" <<'EOF'
[Unit]
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Restart=on-failure
RestartSec=5
TimeoutStopSec=5
EOF
    chmod 644 "$dropin_dir/20-kautuka-restart.conf"
    systemctl daemon-reload
}

resolve_user_runtime_dir() {
    local service_user="$1"
    local service_uid=''
    service_uid="$(id -u "$service_user")"
    printf '/run/user/%s\n' "$service_uid"
}

run_as_service_user() {
    local service_user="$1"
    local service_home="$2"
    local xdg_runtime_dir="$3"
    shift 3

    local dbus_session_bus_address="unix:path=${xdg_runtime_dir}/bus"
    if command -v runuser >/dev/null 2>&1; then
        runuser -u "$service_user" -- env HOME="$service_home" XDG_RUNTIME_DIR="$xdg_runtime_dir" DBUS_SESSION_BUS_ADDRESS="$dbus_session_bus_address" \
            sh -c 'cd "$HOME" || exit; exec "$@"' kautuka "$@"
        return
    fi

    if command -v su >/dev/null 2>&1; then
        local quoted_command=''
        printf -v quoted_command 'cd %q && export HOME=%q XDG_RUNTIME_DIR=%q DBUS_SESSION_BUS_ADDRESS=%q && exec' "$service_home" "$service_home" "$xdg_runtime_dir" "$dbus_session_bus_address"
        local arg=''
        for arg in "$@"; do
            printf -v quoted_command '%s %q' "$quoted_command" "$arg"
        done
        su -s /bin/sh "$service_user" -c "$quoted_command"
        return
    fi

    fail "either runuser or su is required to validate rootless Podman for ${service_user}"
}

icu_library_available() {
    local library="$1"
    local candidate=''

    if command -v ldconfig >/dev/null 2>&1 \
        && ldconfig -p 2>/dev/null | grep -Eq "${library}\\.so([.[:space:]]|$)"; then
        return 0
    fi

    for candidate in \
        "/usr/lib64/${library}.so"* \
        "/usr/lib/x86_64-linux-gnu/${library}.so"* \
        "/usr/lib/${library}.so"*; do
        if [[ -e "$candidate" ]]; then
            return 0
        fi
    done

    return 1
}

ensure_dotnet_host_libraries() {
    if icu_library_available libicuuc; then
        return
    fi

    if command -v dnf >/dev/null 2>&1; then
        dnf install -y libicu >/dev/null
    elif command -v apt-get >/dev/null 2>&1; then
        DEBIAN_FRONTEND=noninteractive apt-get install -y libicu-dev >/dev/null
    fi

    if icu_library_available libicuuc; then
        return
    fi

    fail "libicu is required to run Kautuka host services. Install the distro ICU package and rerun."
}

ensure_rootless_idmap_helpers() {
    local uidmap=''
    local gidmap=''
    uidmap="$(command -v newuidmap)"
    gidmap="$(command -v newgidmap)"
    [[ -n "$uidmap" && -n "$gidmap" ]] || fail "newuidmap/newgidmap are required for rootless Podman"

    if command -v setcap >/dev/null 2>&1; then
        # A setuid-root helper already receives the required capabilities. Adding
        # a restricted file capability to it can prevent uid/gid map access.
        if [[ -u "$uidmap" ]]; then setcap -r "$uidmap" 2>/dev/null || true; else setcap cap_setuid=ep "$uidmap" || true; fi
        if [[ -u "$gidmap" ]]; then setcap -r "$gidmap" 2>/dev/null || true; else setcap cap_setgid=ep "$gidmap" || true; fi
    fi

    if ! { command -v getcap >/dev/null 2>&1 && getcap "$uidmap" 2>/dev/null | grep -q 'cap_setuid'; } && [[ ! -u "$uidmap" ]]; then
        chmod u+s "$uidmap" "$gidmap"
    fi

    mount --make-rshared / >/dev/null 2>&1 || true
    cat > /etc/systemd/system/kautuka-root-rshared.service <<'EOF'
[Unit]
Description=Make / a shared mount for rootless Podman
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/bin/mount --make-rshared /
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
EOF
    systemctl enable --now kautuka-root-rshared.service >/dev/null
}

ensure_rootless_podman_ready() {
    local service_user="$1"
    local service_group="$2"
    local service_home="$3"
    local xdg_runtime_dir="$4"
    local layout="${5:-host}"
    local graph_root="$service_home/.local/share/containers/storage"
    local run_root="$xdg_runtime_dir/containers"
    local storage_conf_path="$service_home/.config/containers/storage.conf"
    [[ "$layout" == host || "$layout" == containers ]] || fail 'unsupported rootless home layout'

    ensure_subid_entry /etc/subuid "$service_user"
    ensure_subid_entry /etc/subgid "$service_user"
    ensure_rootless_idmap_helpers

    mkdir -p \
        "$service_home" \
        "$service_home/.config/containers" \
        "$service_home/.local/share/containers" \
        "$graph_root"
    if [[ "$layout" == host ]]; then
        chown "$service_user:$service_group" "$service_home"
    else
        # The managed cache needs immutable ancestry even when Podman info fails.
        [[ ! -L "$service_home" && "$(stat -c '%u' "$service_home")" == 0 ]] \
            || fail 'container runtime home must remain root-owned'
    fi
    chown -R "$service_user:$service_group" "$service_home/.config"
    # Rootless Podman stores subordinate-UID ownership inside its image layers.
    # Reinstall may repair the storage directory owners, but must never recurse
    # into graphroot or runroot and rewrite ownership inside those layers.
    chown "$service_user:$service_group" \
        "$service_home/.local" \
        "$service_home/.local/share" \
        "$service_home/.local/share/containers" \
        "$graph_root"

    loginctl enable-linger "$service_user"
    validate_linger_enabled "$service_user"
    install_user_manager_restart_dropin "$service_user"
    systemctl start "user@$(id -u "$service_user").service"

    local attempt=0
    while (( attempt < 10 )); do
        if [[ -d "$xdg_runtime_dir" ]]; then
            break
        fi

        sleep 1
        attempt=$((attempt + 1))
    done

    [[ -d "$xdg_runtime_dir" ]] || fail "rootless Podman runtime directory did not appear: $xdg_runtime_dir"

    mkdir -p "$run_root"
    chown "$service_user:$service_group" "$run_root"

    cat > "$storage_conf_path" <<EOF
[storage]
driver = "overlay"
graphroot = "$graph_root"
runroot = "$run_root"

[storage.options]
mount_program = "/usr/bin/fuse-overlayfs"
EOF
    chown "$service_user:$service_group" "$storage_conf_path"
    chmod 600 "$storage_conf_path"

    run_as_service_user "$service_user" "$service_home" "$xdg_runtime_dir" podman info --format json >/dev/null
}

ensure_service_account() {
    local user="$1"
    local group="$2"
    local internal_state_root="$3"

    if ! getent group "$group" >/dev/null 2>&1; then
        groupadd --system "$group"
    fi

    if ! id "$user" >/dev/null 2>&1; then
        useradd \
            --system \
            --gid "$group" \
            --home-dir "$internal_state_root" \
            --create-home \
            --shell /usr/sbin/nologin \
            "$user"
    fi
}

ensure_isolated_service_account() {
    local user="$1"
    local group="$2"

    if ! getent group "$group" >/dev/null 2>&1; then
        groupadd --system "$group"
    fi

    if ! id "$user" >/dev/null 2>&1; then
        useradd \
            --system \
            --gid "$group" \
            --home-dir /nonexistent \
            --no-create-home \
            --shell /usr/sbin/nologin \
            "$user"
    fi
}

chown_tree_excluding() {
    local root="$1"
    local owner="$2"
    local excluded_root="$3"
    local containers_root="$root/.local/share/containers"
    local credentials_root="$root/credentials"
    local credentials_state_root="$root/credentialsHost"

    [[ -d "$root" ]] || return 0
    chown "$owner" "$root"
    # -h keeps ownership on dangling overlay layer symlinks. GNU chown
    # otherwise dereferences them and aborts a reinstall.
    # credentials/ and credentialsHost/ belong to kautuka-credentials. A 45
    # reinstall left credentialsHost/vault as kautuka:kautuka; CredentialsHost
    # then aborted on SetUnixFileMode with EPERM.
    find "$root" -mindepth 1 \
        \( -path "$excluded_root" -o -path "$excluded_root/*" \
           -o -path "$containers_root" -o -path "$containers_root/*" \
           -o -path "$credentials_root" -o -path "$credentials_root/*" \
           -o -path "$credentials_state_root" -o -path "$credentials_state_root/*" \) -prune \
        -o -exec chown -h "$owner" {} +
}

prepare_mcpb_bundle_share() {
    local internal_state_root="$1"
    local service_group="$2"
    local bundle_root="$internal_state_root/mcpb-bundles"

    getent passwd kautuka-gateway >/dev/null 2>&1 || return 0

    mkdir -p "$bundle_root"
    chown -R "kautuka-gateway:$service_group" "$bundle_root"
    find "$bundle_root" -type d -exec chmod 2750 {} +
    find "$bundle_root" -type f -exec chmod 0640 {} +
}

grant_shared_group_write_excluding() {
    local root="$1"
    local group="$2"
    local excluded_root="$3"
    local containers_root="$root/.local/share/containers"
    local credentials_root="$root/credentials"
    local credentials_state_root="$root/credentialsHost"

    [[ -d "$root" ]] || return 0
    chgrp "$group" "$root"
    chmod g+rwx "$root"
    find "$root" -mindepth 1 \
        \( -path "$excluded_root" -o -path "$excluded_root/*" \
           -o -path "$containers_root" -o -path "$containers_root/*" \
           -o -path "$credentials_root" -o -path "$credentials_root/*" \
           -o -path "$credentials_state_root" -o -path "$credentials_state_root/*" \) -prune \
        -o -exec chgrp -h "$group" {} +
    find "$root" -mindepth 1 \
        \( -path "$excluded_root" -o -path "$excluded_root/*" \
           -o -path "$containers_root" -o -path "$containers_root/*" \
           -o -path "$credentials_root" -o -path "$credentials_root/*" \
           -o -path "$credentials_state_root" -o -path "$credentials_state_root/*" \) -prune \
        -o -type d -exec chmod g+rwx {} + \
        -o -type f -exec chmod g+rw {} +
}

prepare_isolated_service_ancestors() {
    local internal_state_root="$1"
    local visible_root="$2"
    local shared_group="$3"

    mkdir -p "$internal_state_root" "$visible_root/logs"
    chown root:"$shared_group" "$internal_state_root" "$visible_root/logs"
    chmod 0771 "$internal_state_root" "$visible_root/logs"
    if [[ "$visible_root" != "$internal_state_root" ]]; then
        chown root:"$shared_group" "$visible_root"
        chmod 0771 "$visible_root"
    fi
}

extract_release() {
    local artifact="$1"
    local destination="$2"

    mkdir -p "$destination"
    tar -xzf "$artifact" -C "$destination"
}

write_manager_user_unit() {
    local unit_path="$1"
    local install_root="$2"
    local visible_root="$3"

    cat > "$unit_path" <<EOF
[Unit]
Description=Kautuka Manager
After=network.target
PartOf=kautuka.target

[Service]
Type=exec
WorkingDirectory=${install_root}/current
ExecStart=${install_root}/current/kautuka-manager
Environment=Kautuka__Mode=prod
Environment=Kautuka__ContainerStateRoot=/var/lib/kautuka
Environment=Logging__FileLogDirectory=${visible_root}/logs/manager
Restart=always
RestartSec=5
Delegate=yes
KillMode=process
TasksMax=infinity
TimeoutStopSec=70

[Install]
WantedBy=kautuka.target
EOF
}

install_user_target_unit() {
    local user_unit_dir="$1"
    local service_units_csv="$2"
    local wants_dir="$user_unit_dir/default.target.wants"
    local target_path="$user_unit_dir/kautuka.target"

    cat > "$target_path" <<EOF
[Unit]
Description=Kautuka appliance runtime
Wants=${service_units_csv}
After=network.target

[Install]
WantedBy=default.target
EOF
    chmod 0644 "$target_path"

    mkdir -p "$wants_dir"
    ln -sfn ../kautuka.target "$wants_dir/kautuka.target"
}

install_host_service_user() {
    local service_key="$1"
    local service_description="$2"
    local executable_name="$3"
    local source_root="$4"
    local release_id="$5"
    local service_user="$6"
    local service_group="$7"
    local visible_root="$8"
    local unit_dir="$9"
    local payload_mode="${10:-install}"

    [[ -d "$source_root" ]] || return 1

    local install_root="/opt/kautuka/${service_key}"
    local versions_root="$install_root/versions"
    local version_root="$versions_root/$version"
    local current_link="$install_root/current"
    local next_link="$install_root/current.next"
    local unit_name="kautuka-${service_key}.service"
    local unit_path="$unit_dir/${unit_name}"
    local wants_path="$unit_dir/kautuka.target.wants/${unit_name}"
    local log_dir="$visible_root/logs/${service_key}"
    local extra_env=""
    local unit_after="network.target"
    local no_new_privileges="NoNewPrivileges=true"

    [[ "$payload_mode" == install || "$payload_mode" == unit-only ]] || fail 'unsupported host payload installation mode'
    mkdir -p "$log_dir"
    if [[ "$payload_mode" == install ]]; then
        rm -rf "$version_root"
        mkdir -p "$version_root"
        copy_runtime_payload "$source_root" "$version_root"
        chmod +x "$version_root/$executable_name"
        ln -sfn "$version_root" "$next_link"
        mv -Tf "$next_link" "$current_link"
    else
        [[ -x "$version_root/$executable_name" && ! -L "$version_root" ]] || fail 'prepared host payload is missing'
    fi

    case "$service_key" in
        webhost)
            unit_after="kautuka-gateway.service"
            ;;
        gateway)
            unit_after="kautuka-credentialshost.service kautuka-manager.service"
            ;;
        channelhost)
            unit_after="kautuka-gateway.service"
            ;;
        updateservice)
            no_new_privileges=''
            ;;
    esac

    # KillMode=process keeps sudo/apply-release children alive if this unit is
    # stopped mid-apply (default control-group would SIGTERM the helper).
    local kill_mode=''
    if [[ "$service_key" == 'updateservice' ]]; then
        kill_mode='KillMode=process'
    fi

    cat > "$unit_path" <<EOF
[Unit]
Description=Kautuka ${service_description}
After=${unit_after}
PartOf=kautuka.target

[Service]
Type=exec
WorkingDirectory=${install_root}/current
ExecStart=${install_root}/current/${executable_name}
Environment=Kautuka__Mode=prod
Environment=Kautuka__ContainerStateRoot=/var/lib/kautuka
Environment=Logging__FileLogDirectory=${log_dir}
${extra_env}
Restart=always
RestartSec=5
TimeoutStopSec=70
${kill_mode}
${no_new_privileges}

[Install]
WantedBy=kautuka.target
EOF

    mkdir -p "$(dirname "$wants_path")"
    ln -sfn "../${unit_name}" "$wants_path"

    chown -R root:root "$install_root"
    chmod -R go-w "$install_root"
    if [[ "$payload_mode" == install ]]; then
        chown -R "$service_user:$service_group" "$log_dir" "$unit_dir"
    else
        chown "$service_user:$service_group" "$log_dir" "$unit_dir" "$unit_path"
        chown -h "$service_user:$service_group" "$wants_path"
    fi
    chmod 0644 "$unit_path"
    printf '%s\n' "$unit_name"
}

install_isolated_channel_service_system() {
    local service_key="$1"
    local service_description="$2"
    local executable_name="$3"
    local source_root="$4"
    local release_id="$5"
    local runtime_user="$6"
    local runtime_group="$7"
    local visible_root="$8"
    local internal_state_root="$9"

    [[ -d "$source_root" ]] || return 1

    local install_root="/opt/kautuka/${service_key}"
    local version_root="$install_root/versions/$release_id"
    local current_link="$install_root/current"
    local next_link="$install_root/current.next"
    local unit_name="kautuka-${service_key}.service"
    local unit_path="/etc/systemd/system/${unit_name}"
    local log_dir="$visible_root/logs/${service_key}"
    local channel_security_root="$internal_state_root/security/channel"
    local gateway_private_root="$channel_security_root/gateway-private"
    local gateway_trust_root="$channel_security_root/gateway-trust"
    local channel_private_root="$channel_security_root/channel-private"
    local channel_trust_root="$channel_security_root/channel-trust"
    local authority_root="$channel_security_root/offline-authority"
    local authority_root="$channel_security_root/offline-authority"
    local state_write_path="$internal_state_root"
    local dependencies='network-online.target'
    local material_environment=''
    local supplementary_groups=''

    rm -rf "$version_root"
    mkdir -p "$version_root" "$log_dir"
    copy_runtime_payload "$source_root" "$version_root"
    chmod +x "$version_root/$executable_name"
    ln -sfn "$version_root" "$next_link"
    mv -Tf "$next_link" "$current_link"

    if [[ "$service_key" == 'channelhost' ]]; then
        state_write_path="$internal_state_root/channelHost"
        dependencies='network-online.target'
        material_environment="Environment=Kautuka__ChannelGateway__ProductionMaterial__ChannelPrivateRoot=${channel_private_root}
Environment=Kautuka__ChannelGateway__ProductionMaterial__ChannelTrustRoot=${channel_trust_root}"
    elif [[ "$service_key" == 'gateway' ]]; then
        dependencies='network-online.target kautuka-channelhost.service'
        supplementary_groups='SupplementaryGroups=kautuka kautuka-credentials-client'
        material_environment="Environment=Kautuka__ChannelGateway__ProductionMaterial__GatewayPrivateRoot=${gateway_private_root}
Environment=Kautuka__ChannelGateway__ProductionMaterial__GatewayTrustRoot=${gateway_trust_root}"
    else
        fail "isolated channel service is not supported: $service_key"
    fi

    mkdir -p "$state_write_path"
    if [[ "$service_key" == 'channelhost' ]]; then
        chown -R "$runtime_user:$runtime_group" "$state_write_path"
        chmod 0700 "$state_write_path"
    fi
    chown -R "$runtime_user:$runtime_group" "$log_dir"
    chmod 0700 "$log_dir"
    chown -R root:root "$install_root"
    chmod -R go-w "$install_root"

    cat > "$unit_path" <<EOF
[Unit]
Description=Kautuka ${service_description}
Wants=network-online.target
Requires=kautuka-update-recovery.service
After=kautuka-update-recovery.service
Requires=kautuka-channelhost.service
After=${dependencies}

[Service]
Type=exec
User=${runtime_user}
Group=${runtime_group}
${supplementary_groups}
WorkingDirectory=${install_root}/current
ExecStart=${install_root}/current/${executable_name}
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=Kautuka__Mode=prod
Environment=Kautuka__ContainerStateRoot=${internal_state_root}
Environment=Logging__FileLogDirectory=${log_dir}
${material_environment}
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=${state_write_path} ${log_dir} /run/kautuka/${service_key}
Restart=always
RestartSec=5
TimeoutStopSec=70

[Install]
WantedBy=multi-user.target
EOF

    if [[ "$service_key" == 'channelhost' ]]; then
        # ChannelHost has no dependency on itself. Gateway retains the Requires/After edge.
        sed -i '/^Requires=kautuka-channelhost.service$/d' "$unit_path"
    fi

    chmod 0644 "$unit_path"
    printf '%s\n' "$unit_name"
}

install_isolated_credentials_service_system() {
    local source_root="$1"
    local release_id="$2"
    local visible_root="$3"
    local internal_state_root="$4"
    local credential_user='kautuka-credentials'
    local credential_group='kautuka-credentials-client'

    [[ -d "$source_root" ]] || return 1

    if ! getent group "$credential_group" >/dev/null 2>&1; then
        groupadd --system "$credential_group"
    fi
    ensure_isolated_service_account "$credential_user" "$credential_user"
    usermod --append --groups "$credential_group" "$credential_user"
    if id kautuka-gateway >/dev/null 2>&1; then
        usermod --append --groups "$credential_group" kautuka-gateway
    fi

    local install_root='/opt/kautuka/credentialshost'
    local version_root="$install_root/versions/$release_id"
    local current_link="$install_root/current"
    local next_link="$install_root/current.next"
    local unit_name='kautuka-credentialshost.service'
    local unit_path="/etc/systemd/system/${unit_name}"
    local log_dir="$visible_root/logs/credentialshost"
    local credentials_root="$internal_state_root/credentials"
    local credentials_state_root="$internal_state_root/credentialsHost"

    rm -rf "$version_root"
    mkdir -p "$version_root" "$log_dir" "$credentials_root/vault" "$credentials_root/transport" "$credentials_state_root/vault" "$credentials_state_root/transport"
    copy_runtime_payload "$source_root" "$version_root"
    chmod +x "$version_root/kautuka-credentialshost"
    ln -sfn "$version_root" "$next_link"
    mv -Tf "$next_link" "$current_link"

    # Recurse into vault/ and transport/. A 45 bulk-chown left
    # credentialsHost/transport/.ca.key as kautuka:kautuka; CredentialsHost
    # then ABRT-looped on LocalCaMtlsBootstrap ReadAllBytes (EPERM). Directory
    # chown alone does not heal those files when prune skips the tree.
    chown -R root:root "$install_root"
    chmod -R go-w "$install_root"
    chown -R "$credential_user:$credential_user" "$credentials_root/vault" "$credentials_state_root/vault" "$credentials_root/transport" "$credentials_state_root/transport" "$log_dir"
    chown "$credential_user:$credential_group" "$credentials_root" "$credentials_root/transport" "$credentials_state_root" "$credentials_state_root/transport"
    # Gateway needs the client certificate and public CA, but never the CA key.
    # Recursive ownership repair above must preserve this existing access on upgrade.
    local transport_root='' public_material=''
    for transport_root in "$credentials_root/transport" "$credentials_state_root/transport"; do
        for public_material in "$transport_root/.ca.cer" "$transport_root/.credentials-client.pfx"; do
            [[ -f "$public_material" ]] || continue
            chown "$credential_user:$credential_group" "$public_material"
            chmod 0640 "$public_material"
        done
    done
    chmod 0700 "$credentials_root/vault" "$credentials_state_root/vault" "$log_dir"
    chmod 2750 "$credentials_root" "$credentials_root/transport" "$credentials_state_root" "$credentials_state_root/transport"

    cat > "$unit_path" <<EOF
[Unit]
Description=Kautuka CredentialsHost
After=network.target kautuka-update-recovery.service
Requires=kautuka-update-recovery.service
Before=kautuka-gateway.service

[Service]
Type=exec
User=${credential_user}
Group=${credential_group}
UMask=0027
WorkingDirectory=${install_root}/current
ExecStart=${install_root}/current/kautuka-credentialshost
Environment=Kautuka__Mode=prod
Environment=Kautuka__ContainerStateRoot=${internal_state_root}
Environment=Logging__FileLogDirectory=${log_dir}
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=${credentials_root} ${credentials_state_root} ${log_dir} /run/kautuka/credentialshost

[Install]
WantedBy=multi-user.target
EOF

    chmod 0644 "$unit_path"
    printf '%s\n' "$unit_name"
}

# A client can only traverse a 0750 socket directory if it belongs to the owning group.
# The group is always a dedicated "-client" group, never the server's own primary group:
# joining that would also hand over its group-readable state, which is what the
# kautuka-credentials-client split already exists to prevent.
grant_socket_group_membership() {
    local account="$1"
    local group="$2"
    id "$account" >/dev/null 2>&1 || return 0
    getent group "$group" >/dev/null 2>&1 || groupadd --system "$group"
    usermod --append --groups "$group" "$account"
}

# The services address each other over Unix sockets rather than loopback ports. /run is
# tmpfs, so the socket directories are declared to systemd-tmpfiles and recreated on each
# boot.
#
# RuntimeDirectory= cannot do this job: manager, updateservice and webhost are user-scope
# units, whose RuntimeDirectory lands under /run/user/<uid>, and that directory is mode
# 0700 so the system-scope services could never traverse into it.
install_socket_runtime_dirs() {
    local service_user="$1" layout="${2:-host}" service_group="${3:-$1}"
    local tmpfiles_path='/usr/lib/tmpfiles.d/kautuka-sockets.conf'
    [[ "$layout" == host || "$layout" == containers ]] || fail 'unsupported socket deployment layout'

    install -d -m 0755 /usr/lib/tmpfiles.d
    if [[ "$layout" == containers ]]; then
        id "$service_user" >/dev/null 2>&1 || fail 'container runtime socket owner does not exist'
        getent group "$service_group" >/dev/null 2>&1 || fail 'container runtime socket group does not exist'
        {
            printf '%s\n' '# Managed by the Kautuka installer; containers receive only their declared socket mounts.' \
                'd /run/kautuka 0755 root root -' \
                'f /run/kautuka-db-writer.lock 0644 root root -'
            local service
            for service in manager updateservice gateway credentialshost channelhost; do
                printf 'd /run/kautuka/%s 2750 %s %s -\n' "$service" "$service_user" "$service_group"
            done
        } > "$tmpfiles_path"
        chmod 0644 "$tmpfiles_path"
        systemd-tmpfiles --create "$tmpfiles_path"
        return
    fi

    # A clean Linux host does not have these groups pre-created by the WSL image builder.
    # Granting membership first creates the dedicated client groups before tmpfiles checks.
    grant_socket_group_membership "$service_user" kautuka-gateway-client
    grant_socket_group_membership kautuka-gateway kautuka-manager-client
    grant_socket_group_membership kautuka-gateway kautuka-updateservice-client
    grant_socket_group_membership kautuka-gateway kautuka-channelhost-client

    {
        printf '%s\n' \
            '# Managed by the Kautuka installer.' \
            '# One directory per service, owned by that service at 2750, so only the owner' \
            '# and members of its client group can reach the socket inside. The setgid bit' \
            '# makes bind() give the socket that client group instead of the service own' \
            '# group, which is what lets the socket itself be 0660 rather than world-writable.' \
            'd /run/kautuka 0755 root root -' \
            'f /run/kautuka-db-writer.lock 0644 root root -'

        local entry
        local service_key
        local owner
        local group
        for entry in \
            "manager:${service_user}:kautuka-manager-client" \
            "updateservice:${service_user}:kautuka-updateservice-client" \
            'gateway:kautuka-gateway:kautuka-gateway-client' \
            'credentialshost:kautuka-credentials:kautuka-credentials-client' \
            'channelhost:kautuka-channelhost:kautuka-channelhost-client'; do
            IFS=':' read -r service_key owner group <<<"$entry"
            id "$owner" >/dev/null 2>&1 || fail "socket directory owner $owner does not exist yet"
            getent group "$group" >/dev/null 2>&1 || fail "socket directory group $group does not exist yet"
            printf 'd /run/kautuka/%s 2750 %s %s -\n' "$service_key" "$owner" "$group"
        done
    } > "$tmpfiles_path"
    chmod 0644 "$tmpfiles_path"

    # Materialise the directories now: a fresh install starts its services before the
    # next boot would otherwise run systemd-tmpfiles. ProtectSystem=strict units bind
    # these paths at spawn, so a missing directory is NAMESPACE 226 rather than a later
    # bind() error.
    systemd-tmpfiles --create "$tmpfiles_path"
}

install_apply_release_helper() {
    local extracted_root="$1" offline_support='false'
    if [[ -f "$extracted_root/bin/runtime-images.json" ]]; then
        offline_support="$(python3 - "$extracted_root/bin/runtime-images.json" <<'PY'
import json, sys
with open(sys.argv[1]) as stream: inventory = json.load(stream)
images = inventory.get('images')
if inventory.get('schemaVersion') != 1 or not isinstance(images, list):
    raise SystemExit('invalid runtime image inventory')
roles = {'core-credentialshost', 'core-channelhost', 'core-gateway', 'core-webhost',
         'egress-setup', 'egress-envoy', 'egress-dns', 'image-acquisition'}
print('true' if any(isinstance(image, dict) and image.get('id') in roles for image in images) else 'false')
PY
)" || fail 'could not validate offline image support requirements'
    fi
    if [[ "$offline_support" == true ]]; then
        [[ -f "$extracted_root/bin/kautuka-runtime-images" && ! -L "$extracted_root/bin/kautuka-runtime-images" \
            && "$(sed -n '2p' "$extracted_root/bin/kautuka-runtime-images")" == '# Kautuka-Offline-Images-Protocol: 1' ]] \
            || fail 'signed appliance package lacks compatible offline image staging support'
    fi
    mkdir -p /usr/local/lib/kautuka /etc/sudoers.d
    if [[ -f "$extracted_root/bin/kautuka-apply-release" ]]; then
        install -m 0755 "$extracted_root/bin/kautuka-apply-release" /usr/local/lib/kautuka/apply-release
        sed -i 's/\r$//' /usr/local/lib/kautuka/apply-release
    fi
    if [[ -f "$extracted_root/bin/kautuka-update-recovery" ]]; then
        install -m 0755 "$extracted_root/bin/kautuka-update-recovery" /usr/local/lib/kautuka/update-recovery.py
    fi
    if [[ -f "$extracted_root/bin/kautuka-runtime-images" && ! -L "$extracted_root/bin/kautuka-runtime-images" ]]; then
        install -o root -g root -m 0755 "$extracted_root/bin/kautuka-runtime-images" /usr/local/lib/kautuka/runtime-images.py
    fi
    if [[ "$offline_support" == true ]]; then
        [[ "$(/usr/bin/python3 /usr/local/lib/kautuka/runtime-images.py --capabilities)" == offline-image-stage-v1 ]] \
            || fail 'installed offline image staging support is incompatible'
    fi
    [[ -x /usr/local/lib/kautuka/apply-release && -x /usr/local/lib/kautuka/update-recovery.py ]] \
        || fail 'this signed Linux package lacks safe update recovery support; refusing to install an update-capable appliance'
    cat > /etc/systemd/system/kautuka-update-recovery.service <<'EOF'
[Unit]
Description=Kautuka pre-commit database recovery
DefaultDependencies=no
Requires=systemd-tmpfiles-setup.service
After=local-fs.target systemd-tmpfiles-setup.service
Before=multi-user.target kautuka-gateway.service kautuka-channelhost.service kautuka-credentialshost.service
Wants=local-fs.target
ConditionPathExists=/usr/local/lib/kautuka/apply-release

[Service]
Type=oneshot
ExecStart=/usr/local/lib/kautuka/apply-release --boot-recover
RemainAfterExit=yes
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
EOF
    chmod 0644 /etc/systemd/system/kautuka-update-recovery.service
    local service_uid
    service_uid="$(id -u kautuka)"
    install -d -m 0755 "/etc/systemd/system/user@${service_uid}.service.d"
    cat > "/etc/systemd/system/user@${service_uid}.service.d/10-kautuka-recovery.conf" <<'EOF'
[Unit]
Requires=kautuka-update-recovery.service
After=kautuka-update-recovery.service
EOF
    chmod 0644 "/etc/systemd/system/user@${service_uid}.service.d/10-kautuka-recovery.conf"
    if [[ "$(readlink -f "$0")" != "$(readlink -f /usr/local/lib/kautuka/kautuka-install-linux.sh)" ]]; then
        install -m 0755 "$0" /usr/local/lib/kautuka/kautuka-install-linux.sh
    fi
    cat > /etc/sudoers.d/kautuka-apply-release <<'EOF'
kautuka ALL=(root) NOPASSWD: /usr/local/lib/kautuka/apply-release
EOF
    chmod 0440 /etc/sudoers.d/kautuka-apply-release
}

validate_exact_material_inventory() {
    local directory="$1"
    shift
    local expected=("$@")
    local entry=''
    local expected_name=''
    local matched='false'
    local count=0

    [[ -d "$directory" && ! -L "$directory" ]] || fail "channel security inventory directory is missing or unsafe: $directory"
    while IFS= read -r -d '' entry; do
        matched='false'
        for expected_name in "${expected[@]}"; do
            if [[ "$(basename "$entry")" == "$expected_name" ]]; then
                matched='true'
                break
            fi
        done
        [[ "$matched" == 'true' && -f "$entry" && ! -L "$entry" ]] || fail "unexpected channel security inventory entry: $entry"
        count=$((count + 1))
    done < <(find "$directory" -mindepth 1 -maxdepth 1 -print0)

    [[ "$count" -eq "${#expected[@]}" ]] || fail "channel security inventory is incomplete: $directory"
}

validate_material_owner_mode() {
    local path="$1"
    local expected="$2"
    local actual=''
    actual="$(stat -c '%U:%G:%a' "$path")"
    [[ "$actual" == "$expected" ]] || fail "channel security ownership or mode mismatch for $path (expected $expected, found $actual)"
}

apply_channel_security_material_permissions() {
    local internal_state_root="$1"
    local channel_security_root="$internal_state_root/security/channel"
    local gateway_private_root="$channel_security_root/gateway-private"
    local gateway_trust_root="$channel_security_root/gateway-trust"
    local channel_private_root="$channel_security_root/channel-private"
    local channel_trust_root="$channel_security_root/channel-trust"
    local authority_root="$channel_security_root/offline-authority"

    chown kautuka-gateway:kautuka-gateway "$gateway_private_root"
    chmod 0700 "$gateway_private_root"
    chown kautuka-gateway:kautuka-gateway "$gateway_private_root/gateway-channel-client.pfx" "$gateway_private_root/gateway-channel-delegation.pfx"
    chmod 0600 "$gateway_private_root/gateway-channel-client.pfx" "$gateway_private_root/gateway-channel-delegation.pfx"
    find "$gateway_private_root" -maxdepth 1 -type f \( -name '*.next' -o -name '*.previous' \) -exec chown kautuka-gateway:kautuka-gateway {} + -exec chmod 0600 {} +

    chown root:kautuka-gateway "$gateway_trust_root"
    chmod 0750 "$gateway_trust_root"
    chown root:kautuka-gateway "$gateway_trust_root/channel-ca.cer"
    chmod 0440 "$gateway_trust_root/channel-ca.cer"

    chown kautuka-channelhost:kautuka-channelhost "$channel_private_root"
    chmod 0700 "$channel_private_root"
    chown kautuka-channelhost:kautuka-channelhost "$channel_private_root/channel-server.pfx"
    chmod 0600 "$channel_private_root/channel-server.pfx"

    chown root:kautuka-channelhost "$channel_trust_root"
    chmod 0750 "$channel_trust_root"
    chown root:kautuka-channelhost "$channel_trust_root/channel-ca.cer" "$channel_trust_root/gateway-channel-client.cer" "$channel_trust_root/gateway-channel-delegation.cer"
    chmod 0440 "$channel_trust_root/channel-ca.cer" "$channel_trust_root/gateway-channel-client.cer" "$channel_trust_root/gateway-channel-delegation.cer"
    find "$channel_trust_root" -maxdepth 1 -type f \( -name '*.next' -o -name '*.previous' -o -name 'channel-security-rotation.json' \) -exec chown root:kautuka-channelhost {} + -exec chmod 0440 {} +

    chown root:root "$authority_root"
    chmod 0700 "$authority_root"
    chown root:root "$authority_root/channel-ca.key" "$authority_root/channel-ca.cer"
    chmod 0600 "$authority_root/channel-ca.key" "$authority_root/channel-ca.cer"
}

validate_channel_security_material_permissions() {
    local internal_state_root="$1"
    local channel_security_root="$internal_state_root/security/channel"
    local gateway_private_root="$channel_security_root/gateway-private"
    local gateway_trust_root="$channel_security_root/gateway-trust"
    local channel_private_root="$channel_security_root/channel-private"
    local channel_trust_root="$channel_security_root/channel-trust"
    local authority_root="$channel_security_root/offline-authority"

    local gateway_private_inventory=(gateway-channel-client.pfx gateway-channel-delegation.pfx)
    local channel_trust_inventory=(channel-ca.cer gateway-channel-client.cer gateway-channel-delegation.cer)
    if [[ -e "$gateway_private_root/gateway-channel-client.pfx.next" || -e "$channel_trust_root/gateway-channel-client.cer.next" ]]; then
        [[ -f "$gateway_private_root/gateway-channel-client.pfx.next" && -f "$gateway_private_root/gateway-channel-delegation.pfx.next" && -f "$channel_trust_root/gateway-channel-client.cer.next" && -f "$channel_trust_root/gateway-channel-delegation.cer.next" ]] \
            || fail 'channel security next rotation slot is incomplete'
        gateway_private_inventory+=(gateway-channel-client.pfx.next gateway-channel-delegation.pfx.next)
        channel_trust_inventory+=(gateway-channel-client.cer.next gateway-channel-delegation.cer.next)
    fi
    if [[ -e "$gateway_private_root/gateway-channel-client.pfx.previous" || -e "$channel_trust_root/gateway-channel-client.cer.previous" ]]; then
        [[ -f "$gateway_private_root/gateway-channel-client.pfx.previous" && -f "$gateway_private_root/gateway-channel-delegation.pfx.previous" && -f "$channel_trust_root/gateway-channel-client.cer.previous" && -f "$channel_trust_root/gateway-channel-delegation.cer.previous" && -f "$channel_trust_root/channel-security-rotation.json" ]] \
            || fail 'channel security previous rotation slot or manifest is incomplete'
        gateway_private_inventory+=(gateway-channel-client.pfx.previous gateway-channel-delegation.pfx.previous)
        channel_trust_inventory+=(gateway-channel-client.cer.previous gateway-channel-delegation.cer.previous channel-security-rotation.json)
    fi

    validate_exact_material_inventory "$gateway_private_root" "${gateway_private_inventory[@]}"
    validate_exact_material_inventory "$gateway_trust_root" channel-ca.cer
    validate_exact_material_inventory "$channel_private_root" channel-server.pfx
    validate_exact_material_inventory "$channel_trust_root" "${channel_trust_inventory[@]}"
    validate_exact_material_inventory "$authority_root" channel-ca.key channel-ca.cer

    validate_material_owner_mode "$gateway_private_root" 'kautuka-gateway:kautuka-gateway:700'
    validate_material_owner_mode "$gateway_private_root/gateway-channel-client.pfx" 'kautuka-gateway:kautuka-gateway:600'
    validate_material_owner_mode "$gateway_private_root/gateway-channel-delegation.pfx" 'kautuka-gateway:kautuka-gateway:600'
    validate_material_owner_mode "$gateway_trust_root" 'root:kautuka-gateway:750'
    validate_material_owner_mode "$gateway_trust_root/channel-ca.cer" 'root:kautuka-gateway:440'
    validate_material_owner_mode "$channel_private_root" 'kautuka-channelhost:kautuka-channelhost:700'
    validate_material_owner_mode "$channel_private_root/channel-server.pfx" 'kautuka-channelhost:kautuka-channelhost:600'
    validate_material_owner_mode "$channel_trust_root" 'root:kautuka-channelhost:750'
    validate_material_owner_mode "$channel_trust_root/channel-ca.cer" 'root:kautuka-channelhost:440'
    validate_material_owner_mode "$channel_trust_root/gateway-channel-client.cer" 'root:kautuka-channelhost:440'
    validate_material_owner_mode "$channel_trust_root/gateway-channel-delegation.cer" 'root:kautuka-channelhost:440'
    validate_material_owner_mode "$authority_root" 'root:root:700'
    validate_material_owner_mode "$authority_root/channel-ca.key" 'root:root:600'
    validate_material_owner_mode "$authority_root/channel-ca.cer" 'root:root:600'
    while IFS= read -r rotation_path; do
        if [[ "$rotation_path" == "$gateway_private_root/"* ]]; then
            validate_material_owner_mode "$rotation_path" 'kautuka-gateway:kautuka-gateway:600'
        else
            validate_material_owner_mode "$rotation_path" 'root:kautuka-channelhost:440'
        fi
    done < <(find "$gateway_private_root" "$channel_trust_root" -maxdepth 1 -type f \( -name '*.next' -o -name '*.previous' -o -name 'channel-security-rotation.json' \))
}

# Probes whether a service account can read or write a path, as that account.
#
# The test runs through the shell builtin rather than the `test` binary on PATH. Ubuntu
# 26.04 ships uutils coreutils, whose /usr/bin/test does not agree with the kernel about
# supplementary groups: `runuser -u kautuka-gateway -- test -w /var/lib/kautuka` reported
# failure on a root:kautuka:771 directory that the account could demonstrably write, which
# aborted a valid install. The negative assertions below matter more, because there a
# wrong answer passes the check and the isolation it claims to prove goes unverified.
service_account_can_access() {
    local account="$1"
    local mode="$2"
    local path="$3"
    runuser -u "$account" -- sh -c 'test "$1" "$2"' _ "$mode" "$path"
}

validate_isolated_channel_runtime_access() {
    local internal_state_root="$1"
    local visible_root="$2"
    local channel_security_root="$internal_state_root/security/channel"

    validate_material_owner_mode "$internal_state_root" 'root:kautuka:771'
    validate_material_owner_mode "$visible_root/logs" 'root:kautuka:771'
    validate_material_owner_mode "$internal_state_root/channelHost" 'kautuka-channelhost:kautuka-channelhost:700'
    validate_material_owner_mode "$visible_root/logs/channelhost" 'kautuka-channelhost:kautuka-channelhost:700'
    validate_material_owner_mode "$visible_root/logs/gateway" 'kautuka-gateway:kautuka-gateway:700'
    validate_material_owner_mode "$internal_state_root/credentialsHost" 'kautuka-credentials:kautuka-credentials-client:2750'
    validate_material_owner_mode "$internal_state_root/credentialsHost/vault" 'kautuka-credentials:kautuka-credentials:700'

    service_account_can_access kautuka-gateway -r "$channel_security_root/gateway-private/gateway-channel-client.pfx" \
        || fail 'Gateway cannot read its channel client key'
    service_account_can_access kautuka-channelhost -r "$channel_security_root/channel-private/channel-server.pfx" \
        || fail 'ChannelHost cannot read its channel server key'
    if service_account_can_access kautuka-gateway -r "$channel_security_root/channel-private/channel-server.pfx"; then
        fail 'Gateway can read ChannelHost private material'
    fi
    if service_account_can_access kautuka-channelhost -r "$channel_security_root/gateway-private/gateway-channel-client.pfx"; then
        fail 'ChannelHost can read Gateway private material'
    fi
    service_account_can_access kautuka-channelhost -w "$internal_state_root/channelHost" \
        || fail 'ChannelHost cannot write its state directory'
    service_account_can_access kautuka-channelhost -w "$visible_root/logs/channelhost" \
        || fail 'ChannelHost cannot write its log directory'
    service_account_can_access kautuka-gateway -w "$internal_state_root" \
        || fail 'Gateway cannot write shared appliance state'
    service_account_can_access kautuka-gateway -w "$visible_root/logs/gateway" \
        || fail 'Gateway cannot write its log directory'
    service_account_can_access kautuka-credentials -w "$internal_state_root/credentialsHost/vault" \
        || fail 'CredentialsHost cannot write its vault'
    if service_account_can_access kautuka-gateway -r "$internal_state_root/credentialsHost/vault"; then
        fail 'Gateway can read CredentialsHost vault'
    fi
}

validate_existing_channel_security_inventory() {
    local root="$1/security/channel"
    local path=''
    local found='false'
    for path in gateway-private gateway-trust channel-private channel-trust offline-authority; do
        [[ -e "$root/$path" || -L "$root/$path" ]] && found='true'
    done
    [[ "$found" == 'true' ]] || return 0
    for path in gateway-private/gateway-channel-client.pfx gateway-private/gateway-channel-delegation.pfx \
        gateway-trust/channel-ca.cer channel-private/channel-server.pfx channel-trust/channel-ca.cer \
        channel-trust/gateway-channel-client.cer channel-trust/gateway-channel-delegation.cer \
        offline-authority/channel-ca.key offline-authority/channel-ca.cer; do
        [[ -f "$root/$path" ]] || fail "existing channel security material is incomplete at $root; repair or restore it before retrying"
    done
}

provision_or_validate_channel_security_material() {
    local internal_state_root="$1"
    local channelhost_executable="$2"
    local channel_security_root="$internal_state_root/security/channel"
    local gateway_private_root="$channel_security_root/gateway-private"
    local gateway_trust_root="$channel_security_root/gateway-trust"
    local channel_private_root="$channel_security_root/channel-private"
    local channel_trust_root="$channel_security_root/channel-trust"
    local authority_root="$channel_security_root/offline-authority"

    channel_security_material_is_complete() {
        [[ -f "$gateway_private_root/gateway-channel-client.pfx" ]] \
            && [[ -f "$gateway_private_root/gateway-channel-delegation.pfx" ]] \
            && [[ -f "$gateway_trust_root/channel-ca.cer" ]] \
            && [[ -f "$channel_private_root/channel-server.pfx" ]] \
            && [[ -f "$channel_trust_root/channel-ca.cer" ]] \
            && [[ -f "$channel_trust_root/gateway-channel-client.cer" ]] \
            && [[ -f "$channel_trust_root/gateway-channel-delegation.cer" ]] \
            && [[ -f "$authority_root/channel-ca.key" ]] \
            && [[ -f "$authority_root/channel-ca.cer" ]]
    }

    if channel_security_material_is_complete; then
        validate_material_owner_mode "$internal_state_root/security" 'root:root:711'
        validate_material_owner_mode "$channel_security_root" 'root:root:711'
        validate_channel_security_material_permissions "$internal_state_root"
        return
    fi

    if [[ -e "$gateway_private_root" || -e "$gateway_trust_root" || -e "$channel_private_root" || -e "$channel_trust_root" || -e "$authority_root" ]]; then
        fail "existing channel security material is incomplete at $channel_security_root; preserve it and repair or restore the inventory before retrying"
    fi

    mkdir -p "$channel_security_root"
    chown root:root "$internal_state_root/security" "$channel_security_root"
    chmod 0711 "$internal_state_root/security" "$channel_security_root"
    Kautuka__Mode=prod "$channelhost_executable" --provision-channel-security \
        "$gateway_private_root" \
        "$gateway_trust_root" \
        "$channel_private_root" \
        "$channel_trust_root" \
        "$authority_root"
    apply_channel_security_material_permissions "$internal_state_root"
    validate_channel_security_material_permissions "$internal_state_root"
}

install_system_restart_helper() {
    local helper_path="$1"

    mkdir -p "$(dirname "$helper_path")"
    cat > "$helper_path" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

[[ $# -ge 1 ]] || {
    echo 'expected at least one systemd unit name' >&2
    exit 64
}

is_allowed_unit() {
    local candidate="$1"
    case "$candidate" in
        kautuka.target|\
        kautuka-manager.service|\
        kautuka-gateway.service|\
        kautuka-credentialshost.service|\
        kautuka-channelhost.service|\
        kautuka-updateservice.service|\
        kautuka-webhost.service)
            return 0
            ;;
    esac

    return 1
}

unit=''
for unit in "$@"; do
    is_allowed_unit "$unit" || {
        echo "unit not allowed: $unit" >&2
        exit 65
    }
done

systemctl daemon-reload

for unit in "$@"; do
    systemctl --no-block restart "$unit"
done
EOF
    chmod 0755 "$helper_path"
    chown root:root "$helper_path"
}

install_update_service_sudoers() {
    local sudoers_path="$1"
    local helper_path="$2"
    local service_user="$3"

    mkdir -p "$(dirname "$sudoers_path")"
    cat > "$sudoers_path" <<EOF
${service_user} ALL=(root) NOPASSWD: ${helper_path}, ${helper_path} *
EOF
    chmod 0440 "$sudoers_path"
    chown root:root "$sudoers_path"

    if command -v visudo >/dev/null 2>&1; then
        visudo -cf "$sudoers_path" >/dev/null
    fi
}

best_effort_remove_file() {
    local path="$1"

    if [[ -e "$path" || -L "$path" ]]; then
        rm -f "$path"
    fi
}

best_effort_remove_tree() {
    local path="$1"

    if [[ -e "$path" || -L "$path" ]]; then
        rm -rf "$path"
    fi
}

remove_data_tree_or_fail() {
    local path="$1"

    if [[ -e "$path" || -L "$path" ]]; then
        rm -rf -- "$path" || fail "could not delete Kautuka data path: $path"
        [[ ! -e "$path" && ! -L "$path" ]] || fail "Kautuka data remains after deletion attempt: $path"
        printf 'Deleted Kautuka data: %s\n' "$path"
    else
        printf 'No Kautuka data found at: %s\n' "$path"
    fi
}

best_effort_remove_dir_if_empty() {
    local path="$1"

    if [[ -d "$path" ]] && [[ -z "$(find "$path" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null || true)" ]]; then
        rmdir "$path" >/dev/null 2>&1 || true
    fi
}

clear_generated_agent_workspace_state() {
    local visible_root="$1"
    local agents_root="$visible_root/workspaces/agents"
    local agent_workspace=''

    [[ -d "$agents_root" ]] || return 0

    for agent_workspace in "$agents_root"/*; do
        [[ -d "$agent_workspace" ]] || continue
        rm -rf "$agent_workspace/.kautuka"
    done
}

clear_package_import_temp_state() {
    local temp_path=''
    local temp_paths=(
        '/tmp/kautuka-mcpb-import'
        '/tmp/kautuka-skill-import'
        '/tmp/kautuka-mcpb-build'
        /tmp/kautuka-mcpb-import-*
        /tmp/kautuka-skill-import-*
    )

    for temp_path in "${temp_paths[@]}"; do
        [[ -e "$temp_path" || -L "$temp_path" ]] || continue
        best_effort_remove_tree "$temp_path"
    done
}

prompt_yes_no() {
    local prompt_message="$1"
    local default_answer="${2:-no}"
    local response=''

    while true; do
        if [[ "$default_answer" == 'yes' ]]; then
            printf '%s [Y/n]: ' "$prompt_message" >&2
        else
            printf '%s [y/N]: ' "$prompt_message" >&2
        fi

        read -r response || return 1
        response="${response,,}"

        if [[ -z "$response" ]]; then
            [[ "$default_answer" == 'yes' ]]
            return
        fi

        case "$response" in
            y|yes)
                return 0
                ;;
            n|no)
                return 1
                ;;
        esac

        echo 'Please answer yes or no.' >&2
    done
}

capture_preserved_uninstall_state() {
    local source_root="$1"
    local destination_root="$2"
    local source_label="$3"
    local db_path=''

    [[ -d "$source_root" ]] || return 0

    while IFS= read -r -d '' db_path; do
        local relative_path="${db_path#${source_root}/}"
        mkdir -p "$destination_root/$source_label/$(dirname "$relative_path")"
        cp -a "$db_path" "$destination_root/$source_label/$relative_path"
    done < <(find "$source_root" -type f \( -name '*.db' -o -name '*.db-wal' -o -name '*.db-shm' \) -print0)
}

preserve_uninstall_state() {
    local internal_state_root="$1"
    local visible_root="$2"
    local preserve_root=''

    preserve_root="$(mktemp -d)"

    capture_preserved_uninstall_state "$internal_state_root" "$preserve_root" 'internal'
    capture_preserved_uninstall_state "$visible_root" "$preserve_root" 'visible'

    if [[ -d "$visible_root/workspaces" ]]; then
        mkdir -p "$preserve_root/visible"
        cp -a "$visible_root/workspaces" "$preserve_root/visible/workspaces"
    fi

    printf '%s\n' "$preserve_root"
}

restore_preserved_uninstall_state() {
    local preserve_root="$1"
    local internal_state_root="$2"
    local visible_root="$3"

    if [[ -d "$preserve_root/internal" ]]; then
        mkdir -p "$internal_state_root"
        cp -a "$preserve_root/internal/." "$internal_state_root/"
    fi

    if [[ -d "$preserve_root/visible" ]]; then
        mkdir -p "$visible_root"
        cp -a "$preserve_root/visible/." "$visible_root/"
    fi

    clear_generated_agent_workspace_state "$visible_root"
    best_effort_remove_tree "$preserve_root"
}

confirm_uninstall() {
    local delete_data="$1"

    echo 'Warning: this uninstall removes Kautuka services, service accounts, binaries, configuration, installers, and runtime support files.' >&2

    if [[ "$delete_data" == 'true' ]]; then
        echo 'The preserved Kautuka databases and agent workspace files will also be deleted.' >&2
    else
        echo 'By default, Kautuka databases and agent workspace files are preserved. You can remove them now or later by rerunning this script with --uninstall --delete-data.' >&2
    fi

    if [[ "$delete_data" != 'true' ]] && prompt_yes_no 'Delete the preserved Kautuka databases and agent workspace files now as well?' 'no'; then
        delete_data='true'
    fi

    echo >&2
    echo 'Type UNINSTALL to continue, or press Enter to cancel.' >&2

    local confirmation=''
    read -r confirmation || fail 'uninstall cancelled'
    [[ "$confirmation" == 'UNINSTALL' ]] || fail 'uninstall cancelled'

    printf '%s\n' "$delete_data"
}

resolve_uninstall_delete_data() {
    local delete_data="$1"
    local assume_yes="$2"

    # --yes answers every uninstall prompt affirmatively, including the data-removal
    # prompt. Users who want to preserve data should omit --yes and --delete-data.
    if [[ "$assume_yes" == 'true' ]]; then
        delete_data='true'
    fi

    printf '%s\n' "$delete_data"
}

# New appliance releases are self-contained. Never try to pull their offline
# manifest references (the core manifests need not be published to a registry).
prepare_install_offline_images() {
    local content_root="$1" service_user="$2" service_home="$3" xdg_runtime_dir="$4"
    local plan status image_id archive identity inspection
    if plan="$(python3 - "$content_root" <<'PY'
import hashlib, json, pathlib, re, stat, sys
content = pathlib.Path(sys.argv[1])
with (content / 'runtime-images.json').open() as stream:
    inventory = json.load(stream)
entries = inventory.get('images')
if inventory.get('schemaVersion') != 1 or not isinstance(entries, list):
    raise SystemExit('invalid runtime image inventory')
roles = {'kautuka-base', 'openobserve', 'git-pkgs-proxy', 'core-credentialshost',
         'core-channelhost', 'core-gateway', 'core-webhost', 'egress-setup',
         'egress-envoy', 'egress-dns', 'image-acquisition'}
new_roles = roles - {'kautuka-base', 'openobserve', 'git-pkgs-proxy'}
if not any(isinstance(entry, dict) and entry.get('id') in new_roles for entry in entries):
    raise SystemExit(30)  # Legacy payload; caller retains its old image path.
if len(entries) != len(roles):
    raise SystemExit('incomplete offline appliance image inventory')
seen, rows = set(), []
for entry in entries:
    role, digest, name, identity = (entry.get(key) for key in ('id', 'archiveSha256', 'archive', 'localImageId'))
    if role not in roles or role in seen or not isinstance(digest, str) or not re.fullmatch('[a-f0-9]{64}', digest):
        raise SystemExit('invalid offline appliance image binding')
    if name not in (f'{role}-{digest}.tar', f'{role}-{digest}.oci') or entry.get('platform') != 'linux/amd64':
        raise SystemExit('invalid offline appliance archive name/platform')
    if not isinstance(identity, str) or not re.fullmatch('sha256:[a-f0-9]{64}', identity):
        raise SystemExit('missing offline appliance config identity')
    archive = content.parent / 'oci-images' / name
    if not stat.S_ISREG(archive.lstat().st_mode):
        raise SystemExit('offline appliance archive must be a regular file')
    with archive.open('rb') as stream:
        if hashlib.file_digest(stream, 'sha256').hexdigest() != digest:
            raise SystemExit('offline appliance archive differs from signed inventory')
    seen.add(role)
    rows.append((role, str(archive), identity))
# Validate the complete inventory before the first Podman operation.
for row in rows: print('\t'.join(row))
PY
)"; then
        :
    else
        status=$?
        [[ "$status" == 30 ]] && return 30
        fail 'could not validate the complete offline appliance image set'
    fi
    while IFS=$'\t' read -r image_id archive identity; do
        [[ -n "$image_id" ]] || continue
        status=0
        run_as_service_user "$service_user" "$service_home" "$xdg_runtime_dir" podman image exists "$identity" || status=$?
        [[ "$status" == 0 || "$status" == 1 ]] || fail "could not query the runtime image store for '$image_id'"
        if [[ "$status" == 1 ]]; then
            printf 'Loading verified offline image: %s\n' "$image_id"
            # Root opens its private verified payload; only archive bytes reach
            # the runtime owner. No readable temporary payload copy is needed.
            run_as_service_user "$service_user" "$service_home" "$xdg_runtime_dir" podman load < "$archive" \
                || fail "could not load offline image '$image_id'"
        fi
        inspection="$(run_as_service_user "$service_user" "$service_home" "$xdg_runtime_dir" podman image inspect "$identity")" \
            || fail "could not inspect offline image '$image_id'"
        printf '%s' "$inspection" | python3 -c '
import json, sys
value = json.load(sys.stdin)
if not isinstance(value, list) or len(value) != 1:
    raise SystemExit("expected one loaded offline image")
image = value[0]
actual = image.get("Id", "")
if actual.removeprefix("sha256:") != sys.argv[1].removeprefix("sha256:") or image.get("Os") != "linux" or image.get("Architecture") != "amd64":
    raise SystemExit("loaded offline image identity/platform differs from signed inventory")
' "$identity" || fail "offline image '$image_id' failed identity/platform verification"
    done <<< "$plan"
}

prepare_install_images() {
    local content_root="$1"
    local service_user="$2"
    local service_home="$3"
    local xdg_runtime_dir="$4"
    local offline_status=0
    prepare_install_offline_images "$content_root" "$service_user" "$service_home" "$xdg_runtime_dir" && return 0 || offline_status=$?
    [[ "$offline_status" == 30 ]] || return "$offline_status"
    local image_plan=''
    local image_id=''
    local image_ref=''
    local sandbox_base_image=''
    local has_released_kautuka_base='false'
    local proxy_plan=''
    local proxy_image=''
    local proxy_context=''
    local proxy_dockerfile=''
    local proxy_upstream_image=''

    image_plan="$(python3 - "${content_root}/runtime-images.json" <<'PY'
import json
import re
import sys

path = sys.argv[1]
with open(path, encoding="utf-8") as stream:
    document = json.load(stream)
if document.get("schemaVersion") != 1 or not isinstance(document.get("images"), list):
    raise SystemExit("invalid runtime-images.json schema")
for image in document["images"]:
    image_id = image.get("id")
    image_ref = image.get("image")
    if not isinstance(image_id, str) or not re.fullmatch(r"[a-z0-9][a-z0-9-]*", image_id):
        raise SystemExit("runtime image has an invalid id")
    if not isinstance(image_ref, str) or not re.search(r"@sha256:[0-9a-f]{64}$", image_ref):
        raise SystemExit(f"runtime image {image_id!r} is not pinned by sha256 digest")
    print(f"{image_id}\t{image_ref}")
PY
)" || fail 'could not read the signed runtime image list'

    while IFS=$'\t' read -r image_id image_ref; do
        [[ -n "$image_id" && -n "$image_ref" ]] || continue
        [[ "$image_id" == 'kautuka-base' ]] && has_released_kautuka_base='true'
        if run_as_service_user "$service_user" "$service_home" "$xdg_runtime_dir" podman image exists "$image_ref" >/dev/null 2>&1; then
            printf 'Runtime image ready: %s (already cached)\n' "$image_id"
            continue
        fi
        printf '\n==> Downloading pinned runtime image: %s\n    %s\n' "$image_id" "$image_ref"
        run_as_service_user "$service_user" "$service_home" "$xdg_runtime_dir" podman pull "$image_ref" \
            || fail "failed to download required runtime image '$image_id'"
        printf 'Runtime image ready: %s\n' "$image_id"
    done <<< "$image_plan"

    if [[ "$has_released_kautuka_base" != 'true' ]]; then
        [[ -f "${content_root}/sandbox/Dockerfile" ]] || fail 'signed release is missing the Kautuka sandbox Dockerfile'
        sandbox_base_image="$(python3 - "${content_root}/sandbox/Dockerfile" <<'PY'
import re
import sys

text = open(sys.argv[1], encoding="utf-8").read()
match = re.search(r"(?m)^ARG\s+FEDORA_IMAGE=(\S+)\s*$", text)
if not match:
    raise SystemExit("sandbox Dockerfile does not declare FEDORA_IMAGE")
print(match.group(1))
PY
        )" || fail 'could not resolve the Kautuka sandbox base image input'
        if ! run_as_service_user "$service_user" "$service_home" "$xdg_runtime_dir" podman image exists "$sandbox_base_image" >/dev/null 2>&1; then
            printf '\n==> Downloading Kautuka sandbox base image input: %s\n' "$sandbox_base_image"
            run_as_service_user "$service_user" "$service_home" "$xdg_runtime_dir" podman pull "$sandbox_base_image" \
                || fail 'failed to download the Kautuka sandbox base image input'
        else
            printf 'Kautuka sandbox base image input ready: %s (already cached)\n' "$sandbox_base_image"
        fi
    else
        printf 'Kautuka sandbox base image ready: pinned release image was downloaded or already cached.\n'
    fi

proxy_plan="$(python3 - "${content_root}/sidecars.json" "$content_root" "${content_root}/runtime-images.json" <<'PY'
import json
import os
import re
import sys

path, root, runtime_path = sys.argv[1:]
with open(path, encoding="utf-8") as stream:
    document = json.load(stream)
with open(runtime_path, encoding="utf-8") as stream:
    runtime_images = {entry.get("image") for entry in json.load(stream).get("images", [])}
sidecars = document.get("sidecars")
if not isinstance(sidecars, list):
    raise SystemExit("invalid sidecars.json schema")
matches = [entry for entry in sidecars if entry.get("name") == "kautuka-pkgs-proxy"]
if len(matches) != 1:
    raise SystemExit("expected one kautuka-pkgs-proxy sidecar")
sidecar = matches[0]
image = sidecar.get("image")
context = sidecar.get("buildContext")
dockerfile = sidecar.get("dockerfile")
if not isinstance(image, str) or not image.startswith("localhost/"):
    raise SystemExit("package proxy sidecar must use its local wrapper image")
if not isinstance(context, str) or not context:
    raise SystemExit("package proxy sidecar has no build context")
context_path = os.path.normpath(os.path.join(root, context))
if os.path.commonpath([root, context_path]) != os.path.normpath(root):
    raise SystemExit("package proxy build context escapes release payload")
dockerfile_path = os.path.normpath(os.path.join(root, dockerfile)) if dockerfile else os.path.join(context_path, "Dockerfile")
if os.path.commonpath([root, dockerfile_path]) != os.path.normpath(root):
    raise SystemExit("package proxy Dockerfile escapes release payload")
with open(dockerfile_path, encoding="utf-8") as stream:
    from_lines = [line.strip() for line in stream if line.lstrip().upper().startswith("FROM ")]
if len(from_lines) != 1:
    raise SystemExit("package proxy Dockerfile must have one pinned base image")
match = re.fullmatch(r"FROM\s+(\S+)", from_lines[0], flags=re.IGNORECASE)
upstream_image = match.group(1) if match else None
if not isinstance(upstream_image, str) or not re.search(r"@sha256:[0-9a-f]{64}$", upstream_image):
    raise SystemExit("package proxy Dockerfile base image is not pinned by sha256 digest")
if upstream_image not in runtime_images:
    raise SystemExit("package proxy Dockerfile image is absent from the signed runtime image list")
print("\t".join((image, context_path, dockerfile_path, upstream_image)))
PY
)" || fail 'could not resolve the signed package proxy image configuration'
    IFS=$'\t' read -r proxy_image proxy_context proxy_dockerfile proxy_upstream_image <<< "$proxy_plan"
    [[ -d "$proxy_context" && -f "$proxy_dockerfile" ]] || fail 'signed package proxy build files are missing'
    printf 'Package proxy runtime image ready: %s\n' "$proxy_upstream_image"
    printf 'Manager will validate or build the local health-check wrapper: %s\n' "$proxy_image"
}

normalize_sidecar_data_permissions() {
    local internal_state_root="$1"
    local sidecars_root="$internal_state_root/sidecars"
    local sidecar_data_root=''

    [[ -d "$sidecars_root" ]] || return 0

    for sidecar_data_root in "$sidecars_root"/*/data; do
        [[ -d "$sidecar_data_root" ]] || continue
        find "$sidecar_data_root" -type d -exec chmod 0777 {} +
        find "$sidecar_data_root" -type f -exec chmod 0666 {} +
    done
}

prepare_gateway_database_owner() {
    local internal_state_root="$1"
    local database_file="$internal_state_root/kautuka.db"
    local usage_database_file="$internal_state_root/kautuka-usage.db"
    local database_sidecar=''
    local gateway_secret=''
    local agent_database_root="$internal_state_root/agents"
    local agent_database=''

    # Gateway applies owner-only permissions to the database and its SQLite
    # sidecars during startup. Make it the owner before the unit starts, even
    # when a prior manager install created the shared state tree as `kautuka`.
    for database_sidecar in \
        "$database_file" "$database_file-wal" "$database_file-shm" \
        "$usage_database_file" "$usage_database_file-wal" "$usage_database_file-shm"; do
        [[ -e "$database_sidecar" ]] || continue
        chown "kautuka-gateway:kautuka" "$database_sidecar"
        chmod 0600 "$database_sidecar"
    done

    # Gateway also owns each per-agent SQLite store. Existing installations may
    # have these files owned by `kautuka`; Gateway must own them to apply the
    # owner-only mode during startup. Transfer only the database and its SQLite
    # sidecars; the contents and containing directories remain untouched.
    for agent_database in \
        "$agent_database_root"/*/agent.db \
        "$agent_database_root"/*/agent.db-wal \
        "$agent_database_root"/*/agent.db-shm; do
        [[ -e "$agent_database" ]] || continue
        chown "kautuka-gateway:kautuka" "$agent_database"
        chmod 0600 "$agent_database"
    done

    # Previous releases created these under the shared `kautuka` account.
    # Gateway now runs as `kautuka-gateway` and must own each file before it
    # can enforce owner-only permissions during startup.
    for gateway_secret in "$internal_state_root/gateway-auth.key" "$internal_state_root/setup-token"; do
        [[ -e "$gateway_secret" ]] || continue
        chown "kautuka-gateway:kautuka" "$gateway_secret"
        chmod 0600 "$gateway_secret"
    done
}

best_effort_systemctl() {
    if ! command -v systemctl >/dev/null 2>&1; then
        return 0
    fi

    systemctl "$@" >/dev/null 2>&1 || true
}

best_effort_loginctl() {
    if ! command -v loginctl >/dev/null 2>&1; then
        return 0
    fi

    loginctl "$@" >/dev/null 2>&1 || true
}

best_effort_user_systemctl() {
    local service_user="$1"
    local service_home="$2"
    local xdg_runtime_dir="$3"
    shift 3

    if ! command -v systemctl >/dev/null 2>&1; then
        return 0
    fi

    if ! id "$service_user" >/dev/null 2>&1; then
        return 0
    fi

    local dbus_session_bus_address="unix:path=${xdg_runtime_dir}/bus"
    if command -v runuser >/dev/null 2>&1; then
        runuser -u "$service_user" -- env HOME="$service_home" XDG_RUNTIME_DIR="$xdg_runtime_dir" DBUS_SESSION_BUS_ADDRESS="$dbus_session_bus_address" systemctl --user "$@" >/dev/null 2>&1 || true
        return
    fi

    if command -v su >/dev/null 2>&1; then
        local quoted_command=''
        printf -v quoted_command 'cd %q && export HOME=%q XDG_RUNTIME_DIR=%q DBUS_SESSION_BUS_ADDRESS=%q && exec systemctl --user' "$service_home" "$service_home" "$xdg_runtime_dir" "$dbus_session_bus_address"
        local arg=''
        for arg in "$@"; do
            printf -v quoted_command '%s %q' "$quoted_command" "$arg"
        done
        su -s /bin/sh "$service_user" -c "$quoted_command" >/dev/null 2>&1 || true
    fi
}

stop_existing_kautuka_runtime() {
    local service_user="$1"
    local service_home="$2"
    local xdg_runtime_dir="$3"
    local dbus_session_bus_address="unix:path=${xdg_runtime_dir}/bus"
    local unit=''

    # Stop user-scope services before replacing their WorkingDirectory tree. A
    # running Manager whose current directory is removed cannot spawn Podman
    # (Process.Start fails in getcwd), leaving package sidecars and setup broken.
    if command -v runuser >/dev/null 2>&1 && id "$service_user" >/dev/null 2>&1; then
        for unit in kautuka.target kautuka-manager.service kautuka-webhost.service kautuka-updateservice.service; do
            if runuser -u "$service_user" -- env HOME="$service_home" XDG_RUNTIME_DIR="$xdg_runtime_dir" DBUS_SESSION_BUS_ADDRESS="$dbus_session_bus_address" systemctl --user cat "$unit" >/dev/null 2>&1; then
                runuser -u "$service_user" -- env HOME="$service_home" XDG_RUNTIME_DIR="$xdg_runtime_dir" DBUS_SESSION_BUS_ADDRESS="$dbus_session_bus_address" systemctl --user stop "$unit" \
                    || fail "could not stop existing $unit before replacing installed binaries"
            fi
        done
    fi

    # Stop the system-scope services that execute binaries from the same version
    # tree before it is removed. Missing units are expected on a fresh install.
    for unit in kautuka-gateway.service kautuka-channelhost.service kautuka-credentialshost.service; do
        if command -v systemctl >/dev/null 2>&1 && systemctl cat "$unit" >/dev/null 2>&1; then
            systemctl stop "$unit" || fail "could not stop existing $unit before replacing installed binaries"
        fi
    done
}

remove_subid_entry() {
    local file_path="$1"
    local user="$2"

    [[ -f "$file_path" ]] || return 0

    local tmp_file=''
    tmp_file="$(mktemp)"
    local line=''
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ "${line%%:*}" == "$user" ]] && continue
        printf '%s\n' "$line"
    done < "$file_path" > "$tmp_file"
    cat "$tmp_file" > "$file_path"
    rm -f "$tmp_file"
}

remove_service_account_if_safe() {
    local service_user="$1"
    local service_group="$2"

    if ! id "$service_user" >/dev/null 2>&1; then
        return 0
    fi

    local owned_path=''
    local scan_root=''
    local scan_roots=(
        '/etc'
        '/home'
        '/opt'
        '/srv'
        '/usr/local'
        '/var/lib'
        '/var/log'
    )

    for scan_root in "${scan_roots[@]}"; do
        [[ -d "$scan_root" ]] || continue
        owned_path="$(find "$scan_root" -xdev -user "$service_user" -print -quit 2>/dev/null || true)"
        if [[ -n "$owned_path" ]]; then
            echo "Skipped removing service user ${service_user}; files owned by the account still remain at: $owned_path" >&2
            return 0
        fi
    done

    best_effort_remove_file "/var/lib/systemd/linger/${service_user}"
    remove_subid_entry '/etc/subuid' "$service_user"
    remove_subid_entry '/etc/subgid' "$service_user"

    if command -v userdel >/dev/null 2>&1; then
        userdel "$service_user" >/dev/null 2>&1 || echo "warning: failed to remove service user: ${service_user}" >&2
    fi

    if [[ "$service_group" != "$service_user" ]]; then
        return 0
    fi

    if getent group "$service_group" >/dev/null 2>&1 && command -v groupdel >/dev/null 2>&1; then
        groupdel "$service_group" >/dev/null 2>&1 || echo "warning: failed to remove service group: ${service_group}" >&2
    fi
}

uninstall_release() {
    local install_root="$1"
    local internal_state_root="$2"
    local visible_root="$3"
    local unit_name="$4"
    local service_user="$5"
    local delete_data="$6"
    local service_group="$service_user"
    local preserved_state_root=''

    local service_units=(
        "$unit_name"
        'kautuka-gateway.service'
        'kautuka-credentialshost.service'
        'kautuka-channelhost.service'
        'kautuka-updateservice.service'
        'kautuka-webhost.service'
        'kautuka-activate.service'
        'kautuka-activate.path'
        'kautuka.target'
    )

    local service_install_roots=(
        "$install_root"
        '/opt/kautuka/gateway'
        '/opt/kautuka/credentialshost'
        '/opt/kautuka/channelhost'
        '/opt/kautuka/updateservice'
        '/opt/kautuka/webhost'
        '/opt/kautuka/tui'
    )

    local legacy_config_files=(
        '/etc/kautuka/manager.env'
        '/etc/kautuka/gateway.env'
        '/etc/kautuka/credentialshost.env'
        '/etc/kautuka/channelhost.env'
        '/etc/kautuka/updateservice.env'
        '/etc/kautuka/webhost.env'
        '/etc/kautuka/workspacehost.env'
        '/etc/kautuka/paths.json'
        '/etc/kautuka/service-scope.json'
        '/etc/kautuka/update-source.json'
        '/etc/kautuka/manifest-public-key.pem'
    )

    local legacy_shared_user_unit_dirs=(
        '/etc/systemd/user/kautuka-manager.service.d'
    )

    local legacy_system_unit_dirs=(
        '/etc/systemd/system/kautuka-manager.service.d'
    )

    local legacy_binary_paths=(
        '/opt/kautuka/bin/podman'
    )

    local privileged_helper_paths=(
        '/usr/local/lib/kautuka/restart-system-units'
    )

    local sudoers_paths=(
        '/etc/sudoers.d/kautuka-updateservice'
    )

    local unit=''
    if id "$service_user" >/dev/null 2>&1; then
        local service_home=''
        local xdg_runtime_dir=''
        local user_unit_dir=''
        service_home="$(get_service_user_home "$service_user")"
        xdg_runtime_dir="$(resolve_user_runtime_dir "$service_user")"
        user_unit_dir="$service_home/.config/systemd/user"

        for unit in "${service_units[@]}"; do
            best_effort_user_systemctl "$service_user" "$service_home" "$xdg_runtime_dir" disable --now "$unit"
            best_effort_user_systemctl "$service_user" "$service_home" "$xdg_runtime_dir" reset-failed "$unit"
            best_effort_remove_file "$user_unit_dir/$unit"
        done
        best_effort_user_systemctl "$service_user" "$service_home" "$xdg_runtime_dir" daemon-reload
        best_effort_remove_dir_if_empty "$user_unit_dir/kautuka.target.wants"
        best_effort_remove_dir_if_empty "$user_unit_dir/default.target.wants"
        best_effort_remove_dir_if_empty "$user_unit_dir"
        best_effort_remove_dir_if_empty "$service_home/.config/systemd"
        best_effort_remove_dir_if_empty "$service_home/.config"
    fi

    for unit in "${service_units[@]}"; do
        best_effort_systemctl disable --now "$unit"
        best_effort_systemctl reset-failed "$unit"
        best_effort_remove_file "/etc/systemd/system/$unit"
        best_effort_remove_file "/etc/systemd/user/$unit"
    done

    local legacy_shared_user_unit_dir=''
    for legacy_shared_user_unit_dir in "${legacy_shared_user_unit_dirs[@]}"; do
        best_effort_remove_tree "$legacy_shared_user_unit_dir"
    done

    local legacy_system_unit_dir=''
    for legacy_system_unit_dir in "${legacy_system_unit_dirs[@]}"; do
        best_effort_remove_tree "$legacy_system_unit_dir"
    done

    best_effort_systemctl daemon-reload

    local install_path=''
    for install_path in "${service_install_roots[@]}"; do
        best_effort_remove_tree "$install_path"
    done

    local legacy_binary_path=''
    for legacy_binary_path in "${legacy_binary_paths[@]}"; do
        best_effort_remove_file "$legacy_binary_path"
    done

    local privileged_helper_path=''
    for privileged_helper_path in "${privileged_helper_paths[@]}"; do
        best_effort_remove_file "$privileged_helper_path"
    done

    local sudoers_path=''
    for sudoers_path in "${sudoers_paths[@]}"; do
        best_effort_remove_file "$sudoers_path"
    done

    best_effort_remove_file '/usr/local/bin/kautuka'
    best_effort_remove_file '/usr/local/bin/kautuka-tui'
    local legacy_config_file=''
    for legacy_config_file in "${legacy_config_files[@]}"; do
        best_effort_remove_file "$legacy_config_file"
    done

    best_effort_remove_dir_if_empty '/etc/systemd/user'
    best_effort_remove_dir_if_empty '/opt/kautuka'
    best_effort_remove_dir_if_empty '/opt/kautuka/bin'
    best_effort_remove_dir_if_empty '/usr/local/lib/kautuka'
    best_effort_remove_dir_if_empty '/usr/local/lib'

    if id "$service_user" >/dev/null 2>&1; then
        local service_uid=''
        service_uid="$(id -u "$service_user")"
        best_effort_loginctl disable-linger "$service_user"
        if [[ -n "$service_uid" ]]; then
            best_effort_systemctl stop "user@${service_uid}.service"
            best_effort_remove_file "/etc/systemd/system/user@${service_uid}.service.d/20-kautuka-restart.conf"
            best_effort_remove_dir_if_empty "/etc/systemd/system/user@${service_uid}.service.d"
        fi
    fi

    if [[ "$delete_data" == 'true' ]]; then
        echo 'Deleting Kautuka configuration, databases, credentials, security material, logs, and agent workspaces.'
        best_effort_remove_tree '/etc/kautuka'
        remove_data_tree_or_fail "$internal_state_root"
        if [[ "$visible_root" != "$internal_state_root" ]]; then
            remove_data_tree_or_fail "$visible_root"
        fi
        clear_package_import_temp_state
    else
        preserved_state_root="$(preserve_uninstall_state "$internal_state_root" "$visible_root")"
        best_effort_remove_tree '/etc/kautuka'
        best_effort_remove_tree "$internal_state_root"
        best_effort_remove_tree "$visible_root"
        clear_package_import_temp_state
        restore_preserved_uninstall_state "$preserved_state_root" "$internal_state_root" "$visible_root"
    fi

    remove_service_account_if_safe "$service_user" "$service_group"
    remove_service_account_if_safe 'kautuka-gateway' 'kautuka-gateway'
    remove_service_account_if_safe 'kautuka-channelhost' 'kautuka-channelhost'

    echo 'Removed Kautuka Linux services and installed binaries.'
    if [[ "$delete_data" == 'true' ]]; then
        echo 'Kautuka uninstall completed with data deletion.'
    else
        if [[ "$visible_root" == "$internal_state_root" ]]; then
            echo "Preserved Kautuka databases and agent workspace files under: $internal_state_root"
        else
            echo "Preserved Kautuka databases and agent workspace files under: $internal_state_root and $visible_root"
        fi
    fi
}

wait_for_web_ui() {
    local service_user="${1:-kautuka}"
    local url="${2:-}"
    local timeout_seconds="${3:-${KAUTUKA_INSTALL_READINESS_TIMEOUT_SECONDS:-600}}"
    local elapsed=0
    local service_uid=''
    local xdg_runtime_dir=''
    local last_status=''
    local health_url=''
    local setup_status_url=''
    local health_file=''
    local curl_error_file=''
    local health_summary=''
    local previous_progress=''
    local startup_started_at=''
    local http_status=''
    local setup_http_status=''
    local setup_needs_setup='unknown'
    local connector_progress=''
    local image_progress=''
    local credentials_state=''
    local channelhost_state=''
    local updateservice_state=''

    service_uid="$(id -u "$service_user")"
    xdg_runtime_dir="/run/user/${service_uid}"

    if [[ -z "$url" ]]; then
        local web_port
        web_port="$(resolve_web_ui_port)"
        url="http://127.0.0.1:${web_port}"
    fi

    [[ "$timeout_seconds" =~ ^[1-9][0-9]*$ ]] || fail 'installer readiness timeout must be a positive integer'

    health_url="${url%/}/api/runtime/system-health"
    setup_status_url="${url%/}/api/auth/setup/status"
    health_file="$(mktemp)"
    curl_error_file="$(mktemp)"
    startup_started_at="$(date --iso-8601=seconds)"

    echo "Installation files are in place. Starting Kautuka services..."
    echo "Waiting for the web UI and core runtime readiness at: $url"
    echo "The first start can take several minutes while required runtime components initialize."

    while (( elapsed < timeout_seconds )); do
        local gateway_state manager_state webhost_state
        gateway_state="$(systemctl show -p ActiveState --value kautuka-gateway.service 2>/dev/null || true)"
        credentials_state="$(systemctl show -p ActiveState --value kautuka-credentialshost.service 2>/dev/null || true)"
        channelhost_state="$(systemctl show -p ActiveState --value kautuka-channelhost.service 2>/dev/null || true)"
        manager_state="$(run_as_service_user "$service_user" "$(get_service_user_home "$service_user")" "$xdg_runtime_dir" \
            systemctl --user show -p ActiveState --value kautuka-manager.service 2>/dev/null || true)"
        webhost_state="$(run_as_service_user "$service_user" "$(get_service_user_home "$service_user")" "$xdg_runtime_dir" \
            systemctl --user show -p ActiveState --value kautuka-webhost.service 2>/dev/null || true)"
        updateservice_state="$(run_as_service_user "$service_user" "$(get_service_user_home "$service_user")" "$xdg_runtime_dir" \
            systemctl --user show -p ActiveState --value kautuka-updateservice.service 2>/dev/null || true)"

        http_status="$(curl --silent --show-error --max-time 5 --output "$health_file" --write-out '%{http_code}' "$health_url" 2>"$curl_error_file" || true)"
        if [[ "$http_status" == '200' ]]; then
            health_summary="$(python3 - "$health_file" <<'PY'
import json
import sys

try:
    with open(sys.argv[1], encoding="utf-8") as stream:
        health = json.load(stream)
    lifecycle = health.get("lifecycle") or {}
    manager = health.get("workspace") or {}
    ready = lifecycle.get("coreReady") is True and manager.get("status") == "healthy"
    status = lifecycle.get("status") or "unknown"
    print(("ready" if ready else "waiting") + "\t" + str(status) + "\t" + str(manager.get("status") or "unknown"))
except (OSError, ValueError, AttributeError, TypeError):
    print("waiting\tinvalid-health-response\tunknown")
PY
        )"
            local readiness lifecycle_status manager_health
            IFS=$'\t' read -r readiness lifecycle_status manager_health <<< "$health_summary"
            setup_http_status="$(curl --silent --show-error --max-time 5 --output "$health_file" --write-out '%{http_code}' "$setup_status_url" 2>"$curl_error_file" || true)"
            setup_needs_setup='unknown'
            if [[ "$setup_http_status" == '200' ]]; then
                setup_needs_setup="$(python3 - "$health_file" <<'PY'
import json
import sys

try:
    with open(sys.argv[1], encoding="utf-8") as stream:
        setup = json.load(stream)
    needs_setup = setup.get("needsSetup")
    print("true" if needs_setup is True else "false" if needs_setup is False else "unknown")
except (OSError, ValueError, AttributeError, TypeError):
    print("unknown")
PY
                )"
            fi
            if [[ "$readiness" == 'ready' && "$setup_http_status" == '200' \
                && ( "$setup_needs_setup" == 'true' || "$setup_needs_setup" == 'false' ) \
                && "$gateway_state" == 'active' && "$credentials_state" == 'active' \
                && "$channelhost_state" == 'active' && "$manager_state" == 'active' \
                && "$webhost_state" == 'active' && "$updateservice_state" == 'active' ]]; then
                echo "Core runtime is ready (lifecycle=${lifecycle_status}; manager=${manager_health})."
                echo "Verified web UI at: $url"
                if [[ "$setup_needs_setup" == 'true' ]]; then
                    confirm_first_admin_setup "$url" || fail 'first-run administrator setup token was not acknowledged'
                fi
                rm -f "$health_file"
                rm -f "$curl_error_file"
                return 0
            fi
            last_status="lifecycle=${lifecycle_status}; manager=${manager_health}"
            if [[ "$setup_http_status" != '200' ]]; then
                last_status+="; first-run endpoint HTTP ${setup_http_status:-unknown}"
            fi
        else
            if [[ "$http_status" =~ ^[0-9]{3}$ && "$http_status" != '000' ]]; then
                last_status="health endpoint returned HTTP $http_status"
                [[ "$http_status" == '502' ]] && last_status+=' (WebHost cannot reach Gateway yet)'
            else
                local curl_detail
                curl_detail="$(tr '\n' ' ' < "$curl_error_file" | sed -E 's/ +/ /g' | cut -c1-180)"
                last_status="WebHost is not answering HTTP yet${curl_detail:+: $curl_detail}"
            fi
        fi

        if (( elapsed % 10 == 0 )); then
            connector_progress="$(journalctl --unit=kautuka-gateway.service --since="$startup_started_at" --no-pager --output=cat 2>/dev/null \
                | grep -E 'Built-in MCP (bootstrap start|bootstrap completed|metadata refresh start|metadata refresh completed)' \
                | tail -n 1 || true)"
            case "$connector_progress" in
                *'metadata refresh start.'*)
                    connector_progress="Preparing first-use connector runtime (an image may need to download): ${connector_progress##*connectorId=}; waiting for its tools to initialize."
                    ;;
                *'metadata refresh completed.'*)
                    connector_progress="Connector tools initialized: ${connector_progress##*connectorId=}."
                    ;;
                *'bootstrap start.'*)
                    connector_progress="Loading built-in connector bundle: ${connector_progress##*/}"
                    ;;
                *'bootstrap completed.'*)
                    connector_progress="Built-in connector initialized: ${connector_progress##*connectorId=}."
                    ;;
                *)
                    connector_progress=''
                    ;;
            esac
            image_progress="$(run_as_service_user "$service_user" "$(get_service_user_home "$service_user")" "$xdg_runtime_dir" \
                journalctl --user-unit=kautuka-manager.service --since="$startup_started_at" --no-pager --output=cat 2>/dev/null \
                | grep -E 'Loading OCI archive|Pulling sidecar image|Building sidecar image|Sidecar kautuka-pkgs-proxy is ready|Sandbox image .*Building from|sandbox-image.*completed' \
                | tail -n 1 || true)"
            case "$image_progress" in
                *'Loading OCI archive'*)
                    image_progress="Loading a bundled runtime image: ${image_progress##*Loading OCI archive }"
                    ;;
                *'Pulling sidecar image'*)
                    image_progress="Downloading a required service image: ${image_progress##*Pulling sidecar image }"
                    ;;
                *'Building sidecar image'*)
                    image_progress='Building the package-proxy service image from the pinned Devkrity mirror.'
                    ;;
                *'Sidecar kautuka-pkgs-proxy is ready'*)
                    image_progress='The package-proxy service image is running and ready.'
                    ;;
                *Sandbox*image*Building*from*)
                    image_progress='Preparing the Kautuka sandbox base image from the Fedora 44 base and installing its runtime tools.'
                    ;;
                *'sandbox-image'*'completed'*)
                    image_progress='Kautuka sandbox base image preparation completed.'
                    ;;
                *)
                    image_progress=''
                    ;;
            esac
            local progress_message="$last_status"
            [[ -n "$connector_progress" ]] && progress_message+="; $connector_progress"
            [[ -n "$image_progress" ]] && progress_message+="; $image_progress"
            if [[ "$progress_message" != "$previous_progress" ]] || (( elapsed % 30 == 0 )); then
                printf 'Startup progress (%ss/%ss): services gateway=%s, credentials=%s, channels=%s, manager=%s, webhost=%s, updates=%s; %s\n' \
                    "$elapsed" "$timeout_seconds" "${gateway_state:-unknown}" "${credentials_state:-unknown}" \
                    "${channelhost_state:-unknown}" "${manager_state:-unknown}" "${webhost_state:-unknown}" \
                    "${updateservice_state:-unknown}" "$progress_message"
                previous_progress="$progress_message"
            fi
        fi

        sleep 2
        elapsed=$((elapsed + 2))
    done

    rm -f "$health_file"
    rm -f "$curl_error_file"
    printf 'error: Kautuka did not become ready within %s seconds (%s).\n' "$timeout_seconds" "$last_status" >&2
    echo 'Check service details with:' >&2
    echo '  sudo systemctl status kautuka-gateway.service kautuka-channelhost.service kautuka-credentialshost.service --no-pager -l' >&2
    echo '  sudo journalctl -b -u kautuka-gateway.service -u kautuka-channelhost.service -u kautuka-credentialshost.service --no-pager -n 80' >&2
    echo "  sudo journalctl -b _UID=$(id -u "$service_user") --no-pager -n 80" >&2
    fail "the installer has not declared success; the UI may respond while core services are still unavailable"
}

confirm_first_admin_setup() {
    local url="$1"
    local token_file="${2:-/var/lib/kautuka/setup-token}"
    local setup_token=''
    local acknowledgment=''

    if [[ ! -r /dev/tty || ! -w /dev/tty ]]; then
        echo 'error: the app is ready, but first-run administrator setup needs a secure interactive terminal.' >&2
        echo 'Run this installer from a terminal to view and acknowledge the one-time setup token.' >&2
        echo "Token recovery command: sudo cat ${token_file}" >&2
        return 1
    fi

    [[ -r "$token_file" ]] || fail "the setup token is not available at ${token_file}"
    setup_token="$(cat "$token_file")"
    [[ "$setup_token" =~ ^[A-F0-9]{64}$ ]] || fail 'the first-run setup token has an unexpected format'

    {
        echo
        echo 'FIRST-RUN SETUP — ACTION REQUIRED'
        echo "Open ${url} in your browser and enter this one-time token to create your first Kautuka administrator."
        echo 'The administrator account controls Kautuka configuration and access. The token is deleted after successful use.'
        echo 'Copy the token now. Do not share it or include it in support logs.'
        printf 'Setup token: %s\n' "$setup_token"
        printf 'Recovery command if you close this terminal: sudo cat %s\n' "$token_file"
    } > /dev/tty

    while true; do
        printf 'Type COPIED after copying the token and understanding that it creates your first administrator on the Kautuka setup page: ' > /dev/tty
        IFS= read -r acknowledgment < /dev/tty || return 1
        if [[ "$acknowledgment" == 'COPIED' ]]; then
            break
        fi
        echo 'Acknowledgement not received. Copy the token, then type COPIED to finish installation.' > /dev/tty
    done

    unset setup_token acknowledgment
    echo 'First-run setup token copied and acknowledged. Continue in the Kautuka setup page.'
}

resolve_web_ui_port() {
    printf '20229\n'
}

write_container_deployment_configuration() {
    python3 - "$1" "$2" <<'PY'
import grp, ipaddress, json, os, pathlib, sys, tempfile, urllib.parse
payload, group = pathlib.Path(sys.argv[1]), sys.argv[2]
path = pathlib.Path('/etc/kautuka/manager.json')
if path.exists() or path.is_symlink():
    info = path.lstat()
    if path.is_symlink() or info.st_uid != 0 or info.st_mode & 0o022:
        raise SystemExit('installed deployment settings must be root-owned and non-writable')
    settings = json.loads(path.read_text())
    if settings.get('CoreServices', {}).get('Enabled') is not True or settings.get('ContainerEgress', {}).get('Enabled') is not True:
        raise SystemExit('installed deployment settings must explicitly enable core and egress')
    upstreams = settings.get('ContainerEgress', {}).get('DnsUpstreams')
    if not isinstance(upstreams, list) or not upstreams:
        raise SystemExit('installed deployment settings require explicit IPv4 DNS upstreams')
    for value in upstreams:
        address = ipaddress.ip_address(value)
        if address.version != 4 or address.is_loopback or address.is_unspecified or address.is_multicast:
            raise SystemExit('installed deployment DNS upstreams must be non-loopback IPv4 addresses')
    otlp = settings.get('Kautuka', {}).get('Telemetry', {}).get('Otlp', {})
    if any(otlp.get(key) != '' for key in ('LogsEndpoint', 'MetricsEndpoint', 'TracesEndpoint')):
        raise SystemExit('container deployment must explicitly disable host OTLP endpoints until managed telemetry is configured')
    os.chown(path, 0, grp.getgrnam(group).gr_gid)
    os.chmod(path, 0o640)
else:
    upstreams = []
    for name in ('/etc/resolv.conf', '/run/systemd/resolve/resolv.conf'):
        resolver = pathlib.Path(name)
        if not resolver.is_file(): continue
        for line in resolver.read_text().splitlines():
            fields = line.split()
            if len(fields) < 2 or fields[0] != 'nameserver': continue
            try: address = ipaddress.ip_address(fields[1])
            except ValueError: continue
            if address.version == 4 and not (address.is_loopback or address.is_unspecified or address.is_multicast) and str(address) not in upstreams:
                upstreams.append(str(address))
    if not upstreams:
        raise SystemExit('configure explicit IPv4 DNS upstreams in /etc/kautuka/manager.json before installation')
    artifacts = ['api.github.com', 'github.com', 'release-assets.githubusercontent.com', 'objects.githubusercontent.com', 'kautuka.store']
    gateway = ['accounts.google.com', 'oauth2.googleapis.com', 'www.googleapis.com', 'openidconnect.googleapis.com', 'login.microsoftonline.com', 'graph.microsoft.com']
    production = payload / 'services/gateway/appsettings.Production.json'
    if production.is_file():
        host = urllib.parse.urlsplit(json.loads(production.read_text()).get('Kautuka', {}).get('ConnectorAuth', {}).get('Host', '')).hostname
        if host: gateway.append(host)
    channel = ['slack.com', 'api.telegram.org', 'wss-primary.slack.com', 'wss-backup.slack.com', 'files.slack.com']
    grants = [dict(ScopeType='core', UserId='system', AgentId=component, Role='core', ComponentId=component, Destination=host, Port=443)
              for component, hosts in (('gateway', gateway), ('channelhost', channel)) for host in hosts]
    settings = {'CoreServices': {'Enabled': True, 'WorkspaceRoot': '/var/lib/kautuka/workspaces', 'ConfigurationRoot': '/var/lib/kautuka/manager/core-config'},
                'ContainerEgress': {'Enabled': True, 'DnsUpstreams': upstreams, 'ArtifactHosts': artifacts, 'Grants': grants},
                'Kautuka': {'Telemetry': {'Otlp': {'LogsEndpoint': '', 'MetricsEndpoint': '', 'TracesEndpoint': ''}}}}
    descriptor, temporary = tempfile.mkstemp(prefix='.manager-', dir=path.parent)
    try:
        with os.fdopen(descriptor, 'w') as stream:
            json.dump(settings, stream, indent=2); stream.write('\n'); stream.flush()
            os.fchown(stream.fileno(), 0, grp.getgrnam(group).gr_gid)
            os.fchmod(stream.fileno(), 0o640); os.fsync(stream.fileno())
        os.replace(temporary, path)
        directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try: os.fsync(directory)
        finally: os.close(directory)
    finally:
        if os.path.exists(temporary): os.unlink(temporary)
PY
}

install_fresh_container_appliance() (
    local payload="$1" service path
    [[ "$service_user" == kautuka && "$service_group" == kautuka \
        && "$internal_state_root" == /var/lib/kautuka && "$visible_root" == /var/lib/kautuka \
        && "$install_root" == /opt/kautuka/manager ]] || fail 'container appliances require the fixed dedicated runtime layout'
    for service in manager updateservice gateway channelhost credentialshost webhost; do
        path="/opt/kautuka/$service/current"
        [[ ! -e "$path" && ! -L "$path" ]] || fail 'existing deployments require the update/recovery handoff; fresh installation will not replace them'
        [[ ! -e "/opt/kautuka/$service/versions/$version" && ! -L "/opt/kautuka/$service/versions/$version" ]] \
            || fail 'prepared version already exists; preserve it for installer recovery'
        for path in "/etc/systemd/system/kautuka-$service.service" "$internal_state_root/.config/systemd/user/kautuka-$service.service"; do
            [[ ! -e "$path" && ! -L "$path" ]] || fail 'existing service units require the lifecycle/recovery handoff'
        done
    done
    for path in /etc/kautuka/service-scope.json "$internal_state_root/.config/systemd/user/kautuka.target" \
        "$internal_state_root/.config/systemd/user/default.target.wants/kautuka.target"; do
        [[ ! -e "$path" && ! -L "$path" ]] || fail 'existing deployment contract or target requires the lifecycle/recovery handoff'
    done
    python3 - "$internal_state_root" <<'PY'
import pathlib, stat, sys
root = pathlib.Path(sys.argv[1])
if root.is_symlink(): raise SystemExit('state root cannot be a symlink')
for parent in (pathlib.Path('/var/lib'), root, pathlib.Path('/opt'), pathlib.Path('/opt/kautuka')):
    if parent.exists() or parent.is_symlink():
        info = parent.lstat()
        if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
            raise SystemExit('fresh container installation requires root-owned, non-writable ancestry')
for service in ('manager', 'updateservice', 'gateway', 'channelhost', 'credentialshost', 'webhost'):
    for parent in (pathlib.Path('/opt/kautuka') / service, pathlib.Path('/opt/kautuka') / service / 'versions'):
        if parent.exists() or parent.is_symlink():
            info = parent.lstat()
            if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
                raise SystemExit('installed version ancestry must be root-owned and non-writable')
for name in ('manager', 'updateService', 'gateway', 'gateway-data', 'credentialsHost', 'channelHost', 'agents', 'security', 'sidecars', 'proxy'):
    path = root / name
    if path.is_symlink() or (path.exists() and (not path.is_dir() or any(entry.is_file() or entry.is_symlink() for entry in path.rglob('*')))):
        raise SystemExit('existing application state requires migration/recovery; no files were changed')
for name in ('kautuka.db', 'kautuka-usage.db', 'channel-outbox.db', 'channel-conversations.db', 'kautuka.key', 'gateway-auth.key'):
    if (root / name).exists() or (root / name).is_symlink():
        raise SystemExit('existing Gateway state requires migration/recovery; no files were changed')
PY
    local activation_started=false config_existed=false
    [[ ! -e /etc/kautuka/manager.json ]] || config_existed=true
    # Until activation, all artifacts below were absent at preflight. Ordinary
    # setup failure removes only this attempt's prepared version roots, links,
    # keys and unit files; immutable caches and the root repair tools may remain.
    cleanup_fresh_container_preparation() {
        local status=$?
        if [[ "$status" != 0 && "$activation_started" == false ]]; then
            python3 - "$version" "$internal_state_root" "$config_existed" <<'PY'
import pathlib, re, shutil, sys
version, state, config_existed = sys.argv[1:]
if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._+-]*', version) or '..' in version: raise SystemExit('unsafe cleanup version')
state = pathlib.Path(state)
if str(state) != '/var/lib/kautuka' or state.is_symlink(): raise SystemExit('unsafe cleanup state root')
versions = [pathlib.Path('/opt/kautuka') / service / 'versions' / version
            for service in ('manager', 'updateservice', 'gateway', 'channelhost', 'credentialshost', 'webhost')]
for path in versions:
    if path.exists() and (path.is_symlink() or path.resolve() != path): raise SystemExit('unsafe prepared version path; retained')
for path in versions:
    for name in ('current', 'current.next'):
        link = path.parent.parent / name
        if link.is_symlink() and link.readlink() == path: link.unlink()
    if path.exists(): shutil.rmtree(path)
units = state / '.config/systemd/user'
if units.exists() and units.resolve() != units: raise SystemExit('unsafe prepared unit path; retained')
for relative in ('kautuka-manager.service', 'kautuka-updateservice.service', 'kautuka.target',
                 'kautuka.target.wants/kautuka-updateservice.service', 'default.target.wants/kautuka.target'):
    path = units / relative
    if path.is_file() or path.is_symlink(): path.unlink()
channel = state / 'security/channel'
if channel.exists():
    if channel.is_symlink() or channel.resolve() != channel: raise SystemExit('unsafe prepared security path; retained')
    shutil.rmtree(channel)
policy = state / 'updateService/update-runtime-policy.json'
if policy.is_file(): policy.unlink()
contract = pathlib.Path('/etc/kautuka/service-scope.json')
if contract.is_file(): contract.unlink()
if config_existed == 'false':
    config = pathlib.Path('/etc/kautuka/manager.json')
    if config.is_file(): config.unlink()
PY
        fi
        exit "$status"
    }
    trap cleanup_fresh_container_preparation EXIT
    ensure_selinux_runtime_exec_policy
    # Creating the account must not give it ownership of the cache's parent.
    [[ -d "$internal_state_root" ]] || install -d -o root -g root -m 0755 "$internal_state_root"
    ensure_service_account "$service_user" "$service_group" "$internal_state_root"
    local service_home xdg_runtime_dir unit_dir content="$payload/bin"
    service_home="$(get_service_user_home "$service_user")"
    [[ "$service_home" == "$internal_state_root" ]] || fail 'container runtime account has a different home directory'
    xdg_runtime_dir="$(resolve_user_runtime_dir "$service_user")"
    unit_dir="$service_home/.config/systemd/user"
    install -d -o root -g "$service_group" -m 0750 "$internal_state_root"
    for path in manager updateService credentialsHost channelHost gateway-data workspaces agents logs sidecars proxy .cache .aspnet; do
        [[ ! -L "$internal_state_root/$path" ]] || fail 'container state directory cannot be a symlink'
        install -d -o "$service_user" -g "$service_group" -m 0700 "$internal_state_root/$path"
    done
    ensure_dotnet_host_libraries
    ensure_rootless_podman_ready "$service_user" "$service_group" "$service_home" "$xdg_runtime_dir" containers
    local existing_containers
    existing_containers="$(run_as_service_user "$service_user" "$service_home" "$xdg_runtime_dir" podman ps --all --format '{{.ID}}')" \
        || fail 'could not inspect the dedicated runtime before fresh installation'
    [[ -z "$existing_containers" ]] || fail 'existing containers require the lifecycle/recovery handoff; no containers were changed'
    install_apply_release_helper "$payload"
    install -d -o "$service_user" -g "$service_group" -m 0700 "$internal_state_root/manager/core-config" "$unit_dir" "$unit_dir/kautuka.target.wants"
    install -d -o root -g root -m 0755 /var/lib/kautuka-recovery
    /usr/bin/python3 /usr/local/lib/kautuka/runtime-images.py "$payload"
    prepare_install_images "$content" "$service_user" "$service_home" "$xdg_runtime_dir"
    install_socket_runtime_dirs "$service_user" containers "$service_group"
    install -d -o root -g "$service_group" -m 0750 /etc/kautuka
    write_container_deployment_configuration "$payload" "$service_group"
    # Preserve the six payload roots expected by the updater; four have no host unit.
    for service in manager updateservice gateway channelhost credentialshost webhost; do
        local source="$payload/services/$service" destination="/opt/kautuka/$service/versions/$version"
        [[ "$service" != manager ]] || source="$content"
        [[ ! -e "$destination" && ! -L "$destination" ]] || fail "version directory already exists: $destination"
        mkdir -p "$destination"
        copy_runtime_payload "$source" "$destination"
        chmod +x "$destination/kautuka-$service"
        chown -R root:root "/opt/kautuka/$service"
        chmod -R go-w "/opt/kautuka/$service"
    done
    [[ "$(run_as_service_user "$service_user" "$service_home" "$xdg_runtime_dir" "/opt/kautuka/manager/versions/$version/kautuka-manager" --update-core-capabilities)" == core-service-update-v1 ]] \
        || fail 'Manager lacks container update lifecycle support'
    local channel_root="$internal_state_root/security/channel"
    install -d -o root -g root -m 0711 "$internal_state_root/security" "$channel_root"
    Kautuka__Mode=prod "/opt/kautuka/channelhost/versions/$version/kautuka-channelhost" --provision-channel-security \
        "$channel_root/gateway-private" "$channel_root/gateway-trust" \
        "$channel_root/channel-private" "$channel_root/channel-trust" "$channel_root/offline-authority"
    for path in gateway-private gateway-trust channel-private channel-trust; do
        chown -R "$service_user:$service_group" "$channel_root/$path"
        chmod 0700 "$channel_root/$path"
        find "$channel_root/$path" -type f -exec chmod 0600 {} +
    done
    chown -R root:root "$channel_root/offline-authority"
    chmod 0700 "$channel_root/offline-authority"
    find "$channel_root/offline-authority" -type f -exec chmod 0600 {} +
    write_initial_update_runtime_policy "$internal_state_root" "$release_channel" "$service_user" "$service_group"
    if [[ -n "$manifest_url" ]]; then
        local source_manifest="$manifest_url"
        [[ "$github_release_candidate" != true ]] || source_manifest=''
        write_update_source_document "$source_manifest" "$service_user" "$service_group"
    fi
    write_trusted_manifest_public_key "$KAUTUKA_DEFAULT_MANIFEST_PUBLIC_KEY_PEM"
    write_manager_user_unit "$unit_dir/kautuka-manager.service" /opt/kautuka/manager "$visible_root"
    install_host_service_user updateservice UpdateService kautuka-updateservice "$payload/services/updateservice" "$version" \
        "$service_user" "$service_group" "$visible_root" "$unit_dir" unit-only >/dev/null
    chown "$service_user:$service_group" "$unit_dir" "$unit_dir/kautuka.target.wants" "$unit_dir/kautuka-manager.service" "$unit_dir/kautuka-updateservice.service"
    # All configuration, payload and material validation precedes publication.
    for service in manager updateservice gateway channelhost credentialshost webhost; do
        ln -s "/opt/kautuka/$service/versions/$version" "/opt/kautuka/$service/current"
    done
    cat > /etc/kautuka/service-scope.json <<'EOF'
{"schemaVersion":2,"username":"kautuka","target":"kautuka.target","applicationServices":"containers","userUnits":["kautuka-manager.service","kautuka-updateservice.service"],"systemUnits":[]}
EOF
    chown root:root /etc/kautuka/service-scope.json
    chmod 0644 /etc/kautuka/service-scope.json
    sync -f /etc/kautuka/service-scope.json
    # Enabling the target permits application processes to create durable state;
    # errors after this point preserve that state and can retry via systemd.
    activation_started=true
    install_user_target_unit "$unit_dir" 'kautuka-manager.service kautuka-updateservice.service'
    systemctl daemon-reload
    best_effort_user_systemctl "$service_user" "$service_home" "$xdg_runtime_dir" daemon-reload
    if [[ "$skip_enable" == true ]]; then
        rm -f -- "$unit_dir/default.target.wants/kautuka.target"
        echo "Installed container appliance $version; host units are written but not started."
        return
    fi
    systemctl enable kautuka-update-recovery.service
    run_as_service_user "$service_user" "$service_home" "$xdg_runtime_dir" systemctl --user enable kautuka.target kautuka-manager.service kautuka-updateservice.service
    # Manager publishes its CA first. Its core worker waits for UpdateService's publication.
    run_as_service_user "$service_user" "$service_home" "$xdg_runtime_dir" systemctl --user start kautuka-manager.service
    local attempt
    for ((attempt=0; attempt<30; attempt++)); do
        [[ ! -f "$internal_state_root/manager/.ca.cer" || ! -f "$internal_state_root/manager/.manager-updateservice-client.pfx" ]] || break
        sleep 1
    done
    [[ -f "$internal_state_root/manager/.ca.cer" && -f "$internal_state_root/manager/.manager-updateservice-client.pfx" ]] \
        || fail 'Manager did not publish the UpdateService bootstrap identity'
    run_as_service_user "$service_user" "$service_home" "$xdg_runtime_dir" systemctl --user start kautuka-updateservice.service
    run_as_service_user "$service_user" "$service_home" "$xdg_runtime_dir" systemctl --user start kautuka.target
    local web_address web_port web_scheme web_probe observed
    web_probe="$(python3 - /etc/kautuka/manager.json <<'PY'
import ipaddress, json, sys
settings = json.load(open(sys.argv[1])).get('CoreServices', {})
address = ipaddress.IPv4Address(settings.get('WebHostBindAddress', '127.0.0.1'))
port = settings.get('WebHostPort', 20229)
if type(port) is not int or not 1 <= port <= 65535: raise SystemExit('invalid WebHost port')
print('\t'.join((str(address) if not address.is_unspecified else '127.0.0.1', str(port),
                 'https' if settings.get('WebHostCertificateDirectory') else 'http')))
PY
)" || fail 'could not resolve the installed WebHost publication'
    IFS=$'\t' read -r web_address web_port web_scheme <<< "$web_probe"
    for ((attempt=0; attempt<120; attempt++)); do
        observed="$(run_as_service_user "$service_user" "$service_home" "$xdg_runtime_dir" podman inspect \
            kautuka-credentialshost kautuka-channelhost kautuka-gateway kautuka-webhost 2>/dev/null)" || observed='[]'
        # This local probe checks availability only; the core supervisor owns
        # certificate/spec validation. No credentials are sent by this request.
        if curl --noproxy '*' --insecure --fail --silent --max-time 2 "$web_scheme://$web_address:$web_port/" >/dev/null \
            && curl --noproxy '*' --fail --silent --max-time 2 --unix-socket /run/kautuka/gateway/gateway.sock http://localhost/api/runtime/system-health 2>/dev/null \
                | python3 -c 'import json,sys; d=json.load(sys.stdin); sys.exit(0 if (d.get("lifecycle") or {}).get("coreReady") is True and (d.get("workspace") or {}).get("status") == "healthy" else 1)' 2>/dev/null \
            && printf '%s' "$observed" | python3 -c '
import json, sys
images = {entry["id"].removeprefix("core-"): entry["localImageId"].removeprefix("sha256:")
          for entry in json.load(open(sys.argv[1]))["images"] if entry["id"].startswith("core-")}
actual = json.load(sys.stdin)
if len(actual) != 4: raise SystemExit(1)
seen = set()
for container in actual:
    labels = container.get("Config", {}).get("Labels", {})
    service = labels.get("kautuka.core-service")
    if service not in images or service in seen or labels.get("kautuka.managed") != "manager" \
            or container.get("State", {}).get("Status") != "running" \
            or container.get("Image", "").removeprefix("sha256:") != images[service]: raise SystemExit(1)
    seen.add(service)
' "$content/runtime-images.json" 2>/dev/null; then
            echo "Installed container appliance $version. Web UI: $web_scheme://$web_address:$web_port"
            local setup_needed
            setup_needed="$(curl --noproxy '*' --fail --silent --max-time 2 \
                --unix-socket /run/kautuka/gateway/gateway.sock http://localhost/api/auth/setup/status \
                | python3 -c 'import json,sys; d=json.load(sys.stdin); v=d.get("needsSetup"); print("true" if v is True else "false" if v is False else "unknown")')" \
                || fail 'could not read first-run setup status; application state was preserved'
            [[ "$setup_needed" != unknown ]] || fail 'first-run setup status is incomplete'
            if [[ "$setup_needed" == true ]]; then
                confirm_first_admin_setup "$web_scheme://$web_address:$web_port" "$internal_state_root/gateway-data/setup-token" \
                    || fail 'first-run administrator setup token was not acknowledged'
            fi
            return
        fi
        sleep 2
    done
    fail 'container appliance did not become ready; preserve its state, inspect the two host-service journals, then retry activation with systemctl --user restart kautuka.target as the runtime owner'
)

main() {
    local artifact=""
    local artifact_url=""
    local feed_base_url=""
    local manifest_url=""
    local version=""
    local release_channel="${KAUTUKA_DEFAULT_RELEASE_CHANNEL:-stable}"
    local release_tag=''
    local release_source_sha=''
    local expected_signature_url=''
    local github_release_candidate='false'
    local install_root="/opt/kautuka/manager"
    local internal_state_root="/var/lib/kautuka"
    local visible_root="/var/lib/kautuka"
    local unit_name="kautuka-manager.service"
    local service_user="kautuka"
    local service_group=""
    local uninstall="false"
    local delete_data="false"
    local assume_yes="false"
    local skip_enable="false"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --artifact)
                artifact="${2:-}"
                shift 2
                ;;
            --artifact-url)
                artifact_url="${2:-}"
                shift 2
                ;;
            --feed-base-url)
                feed_base_url="${2:-}"
                shift 2
                ;;
            --version)
                version="${2:-}"
                shift 2
                ;;
            --install-root)
                install_root="${2:-}"
                shift 2
                ;;
            --internal-state-root)
                internal_state_root="${2:-}"
                shift 2
                ;;
            --visible-root)
                visible_root="${2:-}"
                shift 2
                ;;
            --unit-name)
                unit_name="${2:-}"
                shift 2
                ;;
            --service-user)
                service_user="${2:-}"
                shift 2
                ;;
            --service-group)
                service_group="${2:-}"
                shift 2
                ;;
            --uninstall)
                uninstall="true"
                shift
                ;;
            --delete-data)
                delete_data="true"
                shift
                ;;
            --yes)
                assume_yes="true"
                shift
                ;;
            --skip-enable)
                skip_enable="true"
                shift
                ;;
            --help)
                usage
                exit 0
                ;;
            *)
                fail "unknown argument: $1"
                ;;
        esac
    done

    if [[ -z "$service_group" ]]; then
        service_group="$service_user"
    fi

    if [[ "$delete_data" == 'true' && "$uninstall" != 'true' ]]; then
        fail "--delete-data requires --uninstall"
    fi

    require_root
    require_command systemctl
    require_command loginctl

    if [[ "$uninstall" == 'true' ]]; then
        if [[ "$assume_yes" != 'true' ]]; then
            [[ -t 0 ]] || fail "uninstall requires an interactive terminal unless --yes is provided"
            delete_data="$(confirm_uninstall "$delete_data")"
        else
            delete_data="$(resolve_uninstall_delete_data "$delete_data" "$assume_yes")"
            echo '--yes supplied: confirming uninstall and deletion of Kautuka data.'
        fi

        uninstall_release "$install_root" "$internal_state_root" "$visible_root" "$unit_name" "$service_user" "$delete_data"
        exit 0
    fi

    if [[ -z "$version" && -n "$KAUTUKA_DEFAULT_VERSION" ]]; then
        version="$KAUTUKA_DEFAULT_VERSION"
    fi

    if [[ -z "${KAUTUKA_DEFAULT_RELEASE_CHANNEL:-}" ]]; then
        if [[ "$version" == *-preview.* ]]; then release_channel='preview'; else release_channel='stable'; fi
    fi
    [[ "$release_channel" == 'stable' || "$release_channel" == 'preview' ]] || fail "unsupported release channel: $release_channel"

    if [[ -z "$feed_base_url" && -n "$KAUTUKA_DEFAULT_FEED_BASE_URL" ]]; then
        feed_base_url="$KAUTUKA_DEFAULT_FEED_BASE_URL"
    fi

    if [[ -z "$artifact" && -z "$artifact_url" ]]; then
        if [[ -n "$feed_base_url" ]]; then
            artifact_url="$(artifact_url_from_feed_base_url "$feed_base_url")"
        elif [[ -n "$KAUTUKA_DEFAULT_ARTIFACT_URL" ]]; then
            artifact_url="$KAUTUKA_DEFAULT_ARTIFACT_URL"
        fi
    fi

    if [[ -n "$feed_base_url" ]]; then
        manifest_url="$(manifest_url_from_feed_base_url "$feed_base_url")"
    elif [[ -n "$KAUTUKA_DEFAULT_MANIFEST_URL" ]]; then
        manifest_url="$KAUTUKA_DEFAULT_MANIFEST_URL"
    fi

    if [[ -z "$artifact" && -z "$artifact_url" && -z "$manifest_url" ]]; then
        require_command python3
        require_command curl
        local resolved_release
        resolved_release="$(resolve_github_release_candidate "$release_channel" "$KAUTUKA_DEFAULT_REPOSITORY_OWNER" "$KAUTUKA_DEFAULT_REPOSITORY_NAME")"
        IFS=$'\t' read -r release_tag manifest_url <<< "$resolved_release"
        [[ -n "$release_tag" && -n "$manifest_url" ]] || fail 'GitHub release discovery returned no exact candidate'
        version=''
        github_release_candidate='true'
    fi

    if [[ -z "$artifact" && -z "$artifact_url" ]]; then
        [[ -n "$manifest_url" ]] || fail "either --artifact or --artifact-url is required"
    fi

    if [[ -n "$artifact_url" && -z "$manifest_url" ]]; then
        fail "network install requires the signed release manifest URL embedded in the installer"
    fi

    require_command tar
    require_command install
    require_command mktemp
    require_command getent
    require_command useradd
    require_command usermod
    require_command groupadd
    require_command stat
    require_command runuser
    require_command podman
    require_command sudo
    if [[ -n "$artifact_url" ]]; then
        require_command curl
    fi

    if [[ -n "$manifest_url" ]]; then
        require_command curl
        require_command python3
        require_command openssl
        require_command base64
        require_command sha256sum
    fi

    local tmp_root
    tmp_root="$(mktemp -d)"
    local quoted_tmp_root
    quoted_tmp_root="$(printf '%q' "$tmp_root")"
    trap "rm -rf ${quoted_tmp_root}" EXIT

    if [[ -n "$manifest_url" ]]; then
        require_trusted_manifest_public_key_for_network_install "$manifest_url" "$KAUTUKA_DEFAULT_MANIFEST_PUBLIC_KEY_PEM"
        local manifest_path="$tmp_root/kautuka-platform-release.json"
        local signature_path="$tmp_root/kautuka-platform-release.sig"
        local public_key_path="$tmp_root/manifest-public-key.pem"
        printf '%s\n' "$KAUTUKA_DEFAULT_MANIFEST_PUBLIC_KEY_PEM" > "$public_key_path"
        echo "Downloading signed release manifest from: $manifest_url"
        curl --fail --location --silent --show-error --output "$manifest_path" "$manifest_url"

        local manifest_identity
        manifest_identity="$(python3 - "$manifest_path" "$release_channel" "$KAUTUKA_DEFAULT_REPOSITORY_OWNER" "$KAUTUKA_DEFAULT_REPOSITORY_NAME" "$github_release_candidate" <<'PY'
import json
import re
import sys
import urllib.parse

manifest_path, channel, owner, repository, is_github_candidate = sys.argv[1:]
with open(manifest_path, encoding='utf-8') as stream:
    document = json.load(stream)
tag = document.get('releaseTag')
version = document.get('version')
source_sha = document.get('sourceSha')
release_id = document.get('releaseId')
signature_url = (document.get('signature') or {}).get('url')
artifacts = [item for item in document.get('artifacts', []) if isinstance(item, dict) and item.get('name') == 'kautuka-linux-amd64.tar.gz']
if len(artifacts) != 1:
    raise SystemExit('signed release manifest must contain exactly one Linux platform artifact')
artifact_url = artifacts[0].get('url')
pattern = r'^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$' if channel == 'stable' else r'^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)-preview\.(0|[1-9][0-9]*)$'
match = re.fullmatch(pattern, tag or '')
if is_github_candidate == 'true' and document.get('channel') != channel:
    raise SystemExit('selected GitHub Release manifest belongs to a different release channel')
if is_github_candidate == 'true' and match is None:
    raise SystemExit('selected GitHub Release manifest tag is not a strict stable/preview version')
if is_github_candidate == 'true' and version != tag[1:]:
    raise SystemExit('selected GitHub Release manifest version does not match its exact release tag')
if not isinstance(tag, str) or not isinstance(version, str) or not isinstance(source_sha, str) or not re.fullmatch(r'[0-9a-fA-F]{40}', source_sha):
    raise SystemExit('signed release manifest identity is incomplete')
if is_github_candidate == 'true' and release_id != tag:
    raise SystemExit('selected GitHub Release manifest releaseId does not match its exact release tag')
base = f'https://github.com/{owner}/{repository}/releases/download/{urllib.parse.quote(tag, safe="")}'
expected_signature = f'{base}/kautuka-platform-release.sig'
expected_artifact = f'{base}/kautuka-linux-amd64.tar.gz'
if not isinstance(signature_url, str) or not isinstance(artifact_url, str):
    raise SystemExit('signed release manifest is missing exact signature or artifact URLs')
if is_github_candidate == 'true' and (signature_url != expected_signature or artifact_url != expected_artifact):
    raise SystemExit('selected GitHub Release manifest signature or artifact URL is not its exact-tag asset')
print('\t'.join([tag, version, source_sha.lower(), signature_url, artifact_url, document.get('channel', '')]))
PY
        )" || fail 'signed release manifest identity is invalid'
        IFS=$'\t' read -r manifest_tag manifest_version release_source_sha expected_signature_url manifest_artifact_url manifest_channel <<< "$manifest_identity"
        [[ -n "$version" && "$version" != "$manifest_version" ]] && fail 'signed release manifest version does not match requested version'
        [[ -n "$release_tag" && "$release_tag" != "$manifest_tag" ]] && fail 'signed release manifest tag does not match requested release tag'
        [[ -n "$release_channel" && "$release_channel" != "$manifest_channel" ]] && fail 'signed release manifest channel does not match requested channel'
        version="$manifest_version"
        release_tag="$manifest_tag"
        release_channel="$manifest_channel"
        if [[ -z "$artifact_url" ]]; then artifact_url="$manifest_artifact_url"; fi
        [[ -n "$expected_signature_url" ]] || fail 'signed release manifest has no signature URL'
        curl --fail --location --silent --show-error --output "$signature_path" "$expected_signature_url"
    fi

    [[ -n "$version" ]] || fail "--version is required when installing a local artifact without a signed manifest"
    [[ "$version" =~ ^[A-Za-z0-9][A-Za-z0-9._+-]*$ && "$version" != *..* ]] \
        || fail 'version contains unsafe path characters'

    if [[ -n "$artifact_url" ]]; then
        artifact="$tmp_root/$(basename "$artifact_url")"
        echo "Downloading Manager artifact from: $artifact_url"
        curl --fail --location --progress-bar --output "$artifact" "$artifact_url"
    fi

    [[ -f "$artifact" ]] || fail "artifact not found: $artifact"

    if [[ -n "$manifest_url" ]]; then
        local manifest_artifact_url="$(python3 - "$manifest_path" <<'PY'
import json
import sys

with open(sys.argv[1], encoding='utf-8') as stream:
    manifest = json.load(stream)
artifacts = [item for item in manifest.get('artifacts', []) if item.get('name') == 'kautuka-linux-amd64.tar.gz']
if len(artifacts) == 1 and isinstance(artifacts[0].get('url'), str):
    print(artifacts[0]['url'])
PY
        )" || fail 'signed release manifest has no Linux platform artifact URL'
        [[ -n "$manifest_artifact_url" ]] || fail 'signed release manifest has no Linux platform artifact URL'
        [[ "$artifact_url" == "$manifest_artifact_url" ]] || fail 'selected artifact URL does not match the signed release manifest'
        local verification_args=(
            --manifest "$manifest_path" \
            --signature "$signature_path" \
            --public-key "$public_key_path" \
            --archive "$artifact" \
            --version "$version" \
            --channel "$release_channel" \
            --tag "${release_tag:-v${version}}" \
            --artifact-name 'kautuka-linux-amd64.tar.gz' \
            --artifact-url "$artifact_url" \
            --signature-url "$expected_signature_url"
        )
        if [[ -n "$release_source_sha" ]]; then
            verification_args+=(--source-sha "$release_source_sha")
        fi
        verify_linux_release "${verification_args[@]}"
    fi

    # Share the updater's lock before changing any installed files. An update
    # already being applied must finish before an installer can replace them.
    require_command flock
    exec 9>/run/kautuka-apply.lock
    flock -n 9 || fail 'another Kautuka update or installation is in progress; retry after it finishes'
    assert_no_unresolved_update
    extract_release "$artifact" "$tmp_root/extracted"
    local container_payload
    container_payload="$(python3 - "$tmp_root/extracted/bin/runtime-images.json" <<'PY'
import json, pathlib, sys
path = pathlib.Path(sys.argv[1])
if not path.is_file():
    print('false')
else:
    images = json.loads(path.read_text()).get('images', [])
    roles = {'core-credentialshost', 'core-channelhost', 'core-gateway', 'core-webhost',
             'egress-setup', 'egress-envoy', 'egress-dns', 'image-acquisition'}
    print('true' if any(isinstance(image, dict) and image.get('id') in roles for image in images) else 'false')
PY
)" || fail 'could not select the signed deployment layout'
    if [[ "$container_payload" == true ]]; then
        install_fresh_container_appliance "$tmp_root/extracted"
        return
    fi
    validate_existing_channel_security_inventory "$internal_state_root"

    if [[ -L "$install_root/current" && -x "$install_root/current/kautuka-manager" ]]; then
        echo "Existing Kautuka installation detected at $install_root. Updating to $version while preserving application data."
    fi

    # Do not alter SELinux policy until the signed manifest and archive pass.
    ensure_selinux_runtime_exec_policy

    ensure_service_account "$service_user" "$service_group" "$internal_state_root"
    # Seed the installed release's channel only on a fresh install. Preserve any
    # channel the user has already chosen when reinstalling or upgrading.
    write_initial_update_runtime_policy "$internal_state_root" "$release_channel" "$service_user" "$service_group"
    ensure_isolated_service_account kautuka-gateway kautuka-gateway
    ensure_isolated_service_account kautuka-channelhost kautuka-channelhost
    ensure_isolated_service_account kautuka-credentials kautuka-credentials
    if ! getent group kautuka-credentials-client >/dev/null 2>&1; then
        groupadd --system kautuka-credentials-client
    fi
    usermod --append --groups "$service_group" kautuka-gateway
    usermod --append --groups kautuka-credentials-client kautuka-gateway
    usermod --append --groups kautuka-credentials-client kautuka-credentials
    install_socket_runtime_dirs "$service_user"
    if id -nG kautuka-channelhost | tr ' ' '\n' | grep -Fxq "$service_group"; then
        fail "kautuka-channelhost must not belong to the broad appliance group: $service_group"
    fi
    local service_home
    service_home="$(get_service_user_home "$service_user")"

    local versions_root="$install_root/versions"
    local version_root="$versions_root/$version"
    local current_link="$install_root/current"
    local next_link="$install_root/current.next"
    local xdg_runtime_dir
    xdg_runtime_dir="$(resolve_user_runtime_dir "$service_user")"
    local unit_dir="$service_home/.config/systemd/user"
    local unit_path="$unit_dir/$unit_name"

    ensure_dotnet_host_libraries

    mkdir -p "$versions_root"
    mkdir -p "$internal_state_root/manager"
    mkdir -p "$visible_root/logs/manager"
    mkdir -p "$visible_root/workspaces"
    mkdir -p "$unit_dir"
    mkdir -p "$unit_dir/kautuka.target.wants"

    ensure_rootless_podman_ready "$service_user" "$service_group" "$service_home" "$xdg_runtime_dir"

    install_apply_release_helper "$tmp_root/extracted"

    if [[ -n "$manifest_url" ]]; then
        if [[ "$github_release_candidate" == 'true' ]]; then
            # UpdateService independently discovers the selected signed channel
            # snapshot; never persist a version-pinned bootstrap manifest as its source.
            write_update_source_document '' "$service_user" "$service_group"
        else
            write_update_source_document "$manifest_url" "$service_user" "$service_group"
        fi
    fi
    write_trusted_manifest_public_key "$KAUTUKA_DEFAULT_MANIFEST_PUBLIC_KEY_PEM"
    write_service_scope_document "$service_user" 'kautuka.target'

    local content_root="$tmp_root/extracted"
    if [[ -d "$tmp_root/extracted/bin" ]]; then
        content_root="$tmp_root/extracted/bin"
    fi

    echo 'Preparing Kautuka images with the service account rootless Podman before starting services.'
    prepare_install_images "$content_root" "$service_user" "$service_home" "$xdg_runtime_dir"

    stop_existing_kautuka_runtime "$service_user" "$service_home" "$xdg_runtime_dir"

    # Clear generated workspace runtime state only after the old services stop.
    clear_generated_agent_workspace_state "$visible_root"

    rm -rf "$version_root"
    mkdir -p "$version_root"
    copy_runtime_payload "$content_root" "$version_root"
    chmod +x "$version_root/kautuka-manager"

    chown -R root:root "$install_root"
    chmod -R go-w "$install_root"
    local channel_security_root="$internal_state_root/security"
    chown_tree_excluding "$internal_state_root" "$service_user:$service_group" "$channel_security_root"
    if [[ "$visible_root" != "$internal_state_root" ]]; then
        chown_tree_excluding "$visible_root" "$service_user:$service_group" "$channel_security_root"
    fi
    grant_shared_group_write_excluding "$internal_state_root" "$service_group" "$channel_security_root"
    prepare_isolated_service_ancestors "$internal_state_root" "$visible_root" "$service_group"
    normalize_sidecar_data_permissions "$internal_state_root"
    prepare_gateway_database_owner "$internal_state_root"
    prepare_mcpb_bundle_share "$internal_state_root" "$service_group"

    ln -sfn "$version_root" "$next_link"
    mv -Tf "$next_link" "$current_link"

    write_manager_user_unit "$unit_path" "$install_root" "$visible_root"
    chmod 0644 "$unit_path"
    chown -R "$service_user:$service_group" "$unit_dir"

    local installed_units=()
    local installed_system_units=()
    installed_units+=("$unit_name")

    if [[ -d "$tmp_root/extracted/services/credentialshost" ]]; then
        installed_system_units+=("$(install_isolated_credentials_service_system "$tmp_root/extracted/services/credentialshost" "$version" "$visible_root" "$internal_state_root")")
    fi

    if [[ -d "$tmp_root/extracted/services/channelhost" ]]; then
        installed_system_units+=("$(install_isolated_channel_service_system channelhost ChannelHost kautuka-channelhost "$tmp_root/extracted/services/channelhost" "$version" kautuka-channelhost kautuka-channelhost "$visible_root" "$internal_state_root")")
    fi

    if [[ -d "$tmp_root/extracted/services/gateway" ]]; then
        [[ -d "$tmp_root/extracted/services/channelhost" ]] || fail "production Gateway installation requires the ChannelHost payload"
        installed_system_units+=("$(install_isolated_channel_service_system gateway Gateway kautuka-gateway "$tmp_root/extracted/services/gateway" "$version" kautuka-gateway kautuka-gateway "$visible_root" "$internal_state_root")")
        provision_or_validate_channel_security_material \
            "$internal_state_root" \
            "/opt/kautuka/channelhost/current/kautuka-channelhost"
        validate_isolated_channel_runtime_access "$internal_state_root" "$visible_root"
    fi

    if [[ -d "$tmp_root/extracted/services/updateservice" ]]; then
        installed_units+=("$(install_host_service_user updateservice UpdateService kautuka-updateservice "$tmp_root/extracted/services/updateservice" "$version" "$service_user" "$service_group" "$visible_root" "$unit_dir")")
    fi

    if [[ -d "$tmp_root/extracted/services/webhost" ]]; then
        installed_units+=("$(install_host_service_user webhost WebHost kautuka-webhost "$tmp_root/extracted/services/webhost" "$version" "$service_user" "$service_group" "$visible_root" "$unit_dir")")
    fi

    # Remove the CLI installed by earlier releases; it is no longer shipped.
    best_effort_remove_file '/usr/local/bin/kautuka'
    best_effort_remove_file '/usr/local/bin/kautuka-tui'
    best_effort_remove_tree '/opt/kautuka/tui'

    local activation_target_units=''
    activation_target_units="$(printf '%s\n' "${installed_units[@]}" | paste -sd' ' -)"
    install_user_target_unit "$unit_dir" "$activation_target_units"

    installed_units+=('kautuka.target')

    local legacy_unit=''
    for legacy_unit in "${installed_units[@]}" 'kautuka-gateway.service' 'kautuka-channelhost.service' 'kautuka-activate.service' 'kautuka-activate.path'; do
        best_effort_user_systemctl "$service_user" "$service_home" "$xdg_runtime_dir" disable --now "$legacy_unit"
        best_effort_user_systemctl "$service_user" "$service_home" "$xdg_runtime_dir" reset-failed "$legacy_unit"
        best_effort_systemctl disable --now "$legacy_unit"
        best_effort_systemctl reset-failed "$legacy_unit"
    done

    for legacy_unit in "${installed_units[@]}" 'kautuka-activate.service' 'kautuka-activate.path'; do
        best_effort_remove_file "/etc/systemd/system/$legacy_unit"
    done

    for legacy_unit in 'kautuka-activate.service' 'kautuka-activate.path'; do
        best_effort_remove_file "$unit_dir/$legacy_unit"
    done

    best_effort_remove_dir_if_empty "$unit_dir/kautuka.target.wants"

    best_effort_user_systemctl "$service_user" "$service_home" "$xdg_runtime_dir" daemon-reload
    systemctl daemon-reload

    if [[ "$skip_enable" == "true" ]]; then
        echo "Installed Manager version '$version' at '$version_root'."
        echo "User systemd units written but not enabled or started: ${installed_units[*]}"
        echo "System systemd units written but not enabled or started: ${installed_system_units[*]}"
        exit 0
    fi

    systemctl enable kautuka-update-recovery.service

    best_effort_user_systemctl "$service_user" "$service_home" "$xdg_runtime_dir" enable "${installed_units[@]}"
    best_effort_user_systemctl "$service_user" "$service_home" "$xdg_runtime_dir" start kautuka-manager.service
    if (( ${#installed_system_units[@]} > 0 )); then
        systemctl enable "${installed_system_units[@]}"
        if [[ " ${installed_system_units[*]} " == *' kautuka-credentialshost.service '* ]]; then
            systemctl start kautuka-credentialshost.service
        fi
        if [[ " ${installed_system_units[*]} " == *' kautuka-channelhost.service '* ]]; then
            systemctl start kautuka-channelhost.service
        fi
        if [[ " ${installed_system_units[*]} " == *' kautuka-gateway.service '* ]]; then
            systemctl start kautuka-gateway.service
        fi
    fi
    best_effort_user_systemctl "$service_user" "$service_home" "$xdg_runtime_dir" start kautuka.target
    wait_for_web_ui "$service_user"

    echo "Installed Manager version '$version'."
    echo "Current symlink: $current_link -> $(readlink -f "$current_link")"
    echo "Systemd unit: $unit_path"
    echo "Rootless Podman runtime: $xdg_runtime_dir"
    echo "Access the web UI at: http://localhost:$(resolve_web_ui_port)"
}

if [[ "${KAUTUKA_INSTALL_MANAGER_RELEASE_SOURCE_ONLY:-0}" != '1' ]]; then
    main "$@"
fi
