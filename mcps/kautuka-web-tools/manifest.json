{
  "manifest_version": "0.4",
  "name": "kautuka-web-tools",
  "display_name": "Kautuka Web Tools",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "A collection of tools for Kautuka to perform various web-related tasks.",
  "author": {
    "name": "Kautuka"
  },
  "homepage": "https://github.com/devkrity/kautuka",
  "documentation": "https://github.com/devkrity/kautuka/tree/main/mcps/kautuka-web-tools",
  "compatibility": {
    "platforms": ["darwin", "linux", "win32"],
    "runtimes": {
      "python": ">=3.12,<3.13"
    }
  },
  "server": {
    "type": "uv",
    "entry_point": "src/kautuka_web_tools/server.py",
    "mcp_config": {
      "command": "uv",
      "args": ["run", "python", "-m", "kautuka_web_tools.server"]
    }
  }
}
